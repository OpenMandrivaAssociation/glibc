 NEWS                          |  2 ++
 iconvdata/Makefile            |  5 ++-
 iconvdata/ibm1364.c           |  7 +++-
 iconvdata/tst-iconv-ibm1390.c | 65 +++++++++++++++++++++++++++++++++++
 4 files changed, 77 insertions(+), 2 deletions(-)
 create mode 100644 iconvdata/tst-iconv-ibm1390.c

