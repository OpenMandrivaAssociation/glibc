 $(objpfx)iconv-test.out: run-iconv-test.sh \
 			 $(addprefix $(objpfx), $(gconv-modules)) \
diff --git a/iconvdata/ibm1364.c b/iconvdata/ibm1364.c
index 8df66ea0..f3a0a11f 100644
--- a/iconvdata/ibm1364.c
+++ b/iconvdata/ibm1364.c
@@ -286,7 +286,12 @@ enum
     while (cmbp->res1 < ch)						      \
       ++cmbp;								      \
     /* XXX if last char is beginning of combining store in state */	      \
-    if (cmbp->res1 == ch && inptr + 4 < inend)				      \
+    /* Two UCS-4 units follow: get32 (inptr + 4) reads four bytes, so   \
+       eight bytes must remain.  inptr + 4 < inend is one unit short    \
+       and reads past the buffer when fewer than four bytes follow      \
+       (CVE-2026-124024, bug 34914).  Compare lengths so the check      \
+       does not form a pointer past the object.  */			      \
+    if (cmbp->res1 == ch && inend - inptr >= 8)				      \
       {									      \
 	/* See if input is part of a combined character.  */		      \
 	uint32_t ch_next = get32 (inptr + 4);				      \
diff --git a/iconvdata/tst-iconv-ibm1390.c b/iconvdata/tst-iconv-ibm1390.c
new file mode 100644
index 00000000..3344b70d
--- /dev/null
+++ b/iconvdata/tst-iconv-ibm1390.c
@@ -0,0 +1,65 @@
