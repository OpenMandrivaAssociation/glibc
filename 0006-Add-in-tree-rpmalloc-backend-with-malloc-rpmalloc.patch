+/* Compile rpmalloc's core allocator into glibc.  ENABLE_OVERRIDE is
+   forced off so rpmalloc does not install malloc/free aliases or pull
+   in malloc.c; glibc's malloc-rpmalloc.c shim owns those symbols.  */
+
+#define ENABLE_OVERRIDE 0
+#include "rpmalloc/rpmalloc.c"
diff --git a/malloc/malloc-rpmalloc.c b/malloc/malloc-rpmalloc.c
new file mode 100644
index 0000000..a4056f1
--- /dev/null
+++ b/malloc/malloc-rpmalloc.c
@@ -0,0 +1,496 @@
+/* Shim to use rpmalloc as the malloc implementation inside glibc.
+   Copyright (C) 2026 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.
+
+   The GNU C Library is free software; you can redistribute it and/or
+   modify it under the terms of the GNU Lesser General Public License as
+   published by the Free Software Foundation; either version 2.1 of the
+   License, or (at your option) any later version.
+
+   The GNU C Library is distributed in the hope that it will be useful,
+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+   Lesser General Public License for more details.
+
+   You should have received a copy of the GNU Lesser General Public
+   License along with the GNU C Library; see the file COPYING.LIB.  If
+   not, see <https://www.gnu.org/licenses/>.  */
+
+/* rpmalloc requires explicit per-thread init, handled via a
+   thread-local auto-init guard.  The allocator core lives in
+   malloc/rpmalloc/ and is compiled by malloc-rpmalloc-impl.c.  */
+
+/* Declarations for the rp* API provided by malloc-rpmalloc-impl.c.  */
+#include <stddef.h>
+#include <stdio.h>
+typedef struct rpmalloc_interface_t rpmalloc_interface_t;
+int rpmalloc_initialize (rpmalloc_interface_t *);
+void rpmalloc_thread_initialize (void);
+void rpmalloc_thread_finalize (void);
+void rpmalloc_thread_collect (void);
+void *rpmalloc (size_t);
+void rpfree (void *);
+void *rprealloc (void *, size_t);
+void *rpcalloc (size_t, size_t);
+void *rpmemalign (size_t, size_t);
+void *rpaligned_alloc (size_t, size_t);
+int rpposix_memalign (void **, size_t, size_t);
+size_t rpmalloc_usable_size (void *);
+void rpmalloc_dump_statistics (void *);
+
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <malloc.h>
+#include <libc-symbols.h>
+#include <shlib-compat.h>
+#include <malloc-internal.h>
+#include "malloc-shim-compat.h"
+
+#ifdef MALLOC_MULTI_BACKEND
+# define __libc_malloc __malloc_rpmalloc_malloc
+# define __libc_free __malloc_rpmalloc_free
+# define __libc_realloc __malloc_rpmalloc_realloc
+# define __libc_calloc __malloc_rpmalloc_calloc
+# define __libc_memalign __malloc_rpmalloc_memalign
+# define __libc_valloc __malloc_rpmalloc_valloc
+# define __libc_pvalloc __malloc_rpmalloc_pvalloc
+# define __posix_memalign __malloc_rpmalloc_posix_memalign
+# define aligned_alloc __malloc_rpmalloc_aligned_alloc
+# define free_sized __malloc_rpmalloc_free_sized
+# define free_aligned_sized __malloc_rpmalloc_free_aligned_sized
+# define __malloc_usable_size __malloc_rpmalloc_usable_size
+# define __libc_mallopt __malloc_rpmalloc_mallopt
+# define __libc_mallinfo __malloc_rpmalloc_mallinfo
+# define __libc_mallinfo2 __malloc_rpmalloc_mallinfo2
+# define __malloc_info __malloc_rpmalloc_malloc_info
+# define __malloc_stats __malloc_rpmalloc_malloc_stats
+# define __malloc_trim __malloc_rpmalloc_malloc_trim
+# define __malloc_fork_lock_parent __malloc_rpmalloc_fork_lock_parent
+# define __malloc_fork_unlock_parent __malloc_rpmalloc_fork_unlock_parent
+# define __malloc_fork_unlock_child __malloc_rpmalloc_fork_unlock_child
+# define __malloc_arena_thread_freeres __malloc_rpmalloc_arena_thread_freeres
+# define __malloc_check_init __malloc_rpmalloc_check_init
+# define __ptmalloc_init __malloc_rpmalloc_ptmalloc_init
+# define __glibc_morecore __malloc_rpmalloc_morecore
+# pragma push_macro("libc_hidden_proto")
+# pragma push_macro("libc_hidden_def")
+# pragma push_macro("weak_function")
+# undef libc_hidden_proto
+# define libc_hidden_proto(...) /* nothing */
+# undef libc_hidden_def
+# define libc_hidden_def(...) /* nothing */
+# undef weak_function
+# define weak_function /* nothing */
+# define MALLOC_MULTI_HIDDEN_PUSHED 1
+#endif
+
+
+/* Thread-local auto-initialization.  rpmalloc needs per-thread init.  */
+static __thread int rp_thread_inited = 0;
+static int rp_global_inited = 0;
+
+static inline void
+rp_ensure_init (void)
+{
+  if (__builtin_expect (!rp_global_inited, 0))
+    {
+      rpmalloc_initialize (NULL);
+      rp_global_inited = 1;
+    }
+  if (__builtin_expect (!rp_thread_inited, 0))
+    {
+      rpmalloc_thread_initialize ();
+      rp_thread_inited = 1;
+    }
+}
+
+/* Hidden prototypes.  */
+void *__libc_malloc (size_t);
+libc_hidden_proto (__libc_malloc)
+void __libc_free (void *);
+libc_hidden_proto (__libc_free)
+void *__libc_realloc (void *, size_t);
+libc_hidden_proto (__libc_realloc)
+void *__libc_memalign (size_t, size_t);
+libc_hidden_proto (__libc_memalign)
+struct mallinfo2 __libc_mallinfo2 (void);
+libc_hidden_proto (__libc_mallinfo2)
+int __libc_mallopt (int, int);
+libc_hidden_proto (__libc_mallopt)
+
+void *__libc_calloc (size_t, size_t);
+libc_hidden_proto (__libc_calloc)
+void *__libc_valloc (size_t);
+libc_hidden_proto (__libc_valloc)
+void *__libc_pvalloc (size_t);
+libc_hidden_proto (__libc_pvalloc)
+int __posix_memalign (void **, size_t, size_t);
+libc_hidden_proto (__posix_memalign)
+size_t __malloc_usable_size (void *);
+libc_hidden_proto (__malloc_usable_size)
+
+/* ------------------------------------------------------------------ */
+/* Core allocation entry points                                       */
+/* ------------------------------------------------------------------ */
+
+void *
+__libc_malloc (size_t bytes)
+{
+  void *p;
+  if (malloc_shim_size_too_large (bytes))
+    return malloc_shim_fail_oom ();
+  rp_ensure_init ();
+  p = rpmalloc (bytes);
+  if (p == NULL)
+    __set_errno (ENOMEM);
+  return p;
+}
+libc_hidden_def (__libc_malloc)
+
+void
+__libc_free (void *mem)
+{
+  if (mem == NULL)
+    return;
+  rp_ensure_init ();
+  MALLOC_SHIM_FREE (rpfree (mem));
+}
+libc_hidden_def (__libc_free)
+
+void *
+__libc_realloc (void *oldmem, size_t bytes)
+{
+  void *p;
+  /* glibc: realloc (p, 0) frees p and returns NULL; realloc (NULL, 0)
+     is equivalent to malloc (0) and returns a unique non-NULL pointer.  */
+  if (bytes == 0)
+    {
+      rp_ensure_init ();
+      if (oldmem != NULL)
+	{
+	  rpfree (oldmem);
+	  return NULL;
+	}
+      p = rpmalloc (0);
+      if (p == NULL)
+	__set_errno (ENOMEM);
+      return p;
+    }
+  if (malloc_shim_size_too_large (bytes))
+    return malloc_shim_fail_oom ();
+  rp_ensure_init ();
+  if (oldmem == NULL)
+    {
+      p = rpmalloc (bytes);
+      if (p == NULL)
+	__set_errno (ENOMEM);
+      return p;
+    }
+  if (bytes <= rpmalloc_usable_size (oldmem))
+    return oldmem;
+  p = rprealloc (oldmem, bytes);
+  if (p == NULL)
+    __set_errno (ENOMEM);
+  return p;
+}
+libc_hidden_def (__libc_realloc)
+
+void *
+__libc_calloc (size_t n, size_t elem_size)
+{
+  void *p;
+  size_t bytes;
+  if (__builtin_mul_overflow (n, elem_size, &bytes) || malloc_shim_size_too_large (bytes))
+    return malloc_shim_fail_oom ();
+  rp_ensure_init ();
+  p = rpcalloc (n, elem_size);
+  if (p == NULL)
+    __set_errno (ENOMEM);
+  return p;
+}
+libc_hidden_def (__libc_calloc)
+
+void *
+__libc_memalign (size_t alignment, size_t bytes)
+{
+  void *p;
+  alignment = malloc_shim_align_pow2 (alignment);
+  if (alignment == 0 || malloc_shim_size_too_large (bytes) || malloc_shim_size_too_large (alignment))
+    {
+      __set_errno (alignment == 0 ? EINVAL : ENOMEM);
+      return NULL;
+    }
+  rp_ensure_init ();
+  p = rpmemalign (alignment, bytes);
+  if (p == NULL)
+    __set_errno (ENOMEM);
+  return p;
+}
+libc_hidden_def (__libc_memalign)
+
+void *
+__libc_valloc (size_t bytes)
+{
+  return __libc_memalign (__getpagesize (), bytes);
+}
+libc_hidden_def (__libc_valloc)
+
+void *
+__libc_pvalloc (size_t bytes)
+{
+  size_t rounded = malloc_shim_pvalloc_size (bytes);
+  if (rounded == 0)
+    return malloc_shim_fail_oom ();
+  return __libc_memalign (__getpagesize (), rounded);
+}
+libc_hidden_def (__libc_pvalloc)
+
+int
+__posix_memalign (void **memptr, size_t alignment, size_t size)
+{
+  void *p;
+  if (memptr == NULL
+      || alignment == 0
+      || (alignment & (alignment - 1)) != 0
+      || alignment % sizeof (void *) != 0)
+    return EINVAL;
+  if (malloc_shim_size_too_large (size))
+    return ENOMEM;
+  rp_ensure_init ();
+  p = rpmemalign (alignment, size);
+  if (p == NULL)
+    return ENOMEM;
+  *memptr = p;
+  return 0;
+}
+libc_hidden_def (__posix_memalign)
+
+void *
+weak_function
+aligned_alloc (size_t alignment, size_t bytes)
+{
+  void *p;
+  if (alignment == 0 || (alignment & (alignment - 1)) != 0)
+    {
+      __set_errno (EINVAL);
+      return NULL;
+    }
+  if (malloc_shim_size_too_large (bytes) || malloc_shim_size_too_large (alignment))
+    return malloc_shim_fail_oom ();
+  rp_ensure_init ();
+  p = rpaligned_alloc (alignment, bytes);
+  if (p == NULL)
+    __set_errno (ENOMEM);
+  return p;
+}
+
+void
+weak_function
+free_sized (void *ptr, size_t size __attribute_maybe_unused__)
+{
+  if (ptr == NULL)
+    return;
+  rp_ensure_init ();
+  MALLOC_SHIM_FREE (rpfree (ptr));
+}
+
+void
+weak_function
+free_aligned_sized (void *ptr, size_t alignment __attribute_maybe_unused__,
+                    size_t size __attribute_maybe_unused__)
+{
+  if (ptr == NULL)
+    return;
+  rp_ensure_init ();
+  MALLOC_SHIM_FREE (rpfree (ptr));
+}
+
+/* ------------------------------------------------------------------ */
+/* Extended / informational entry points                              */
+/* ------------------------------------------------------------------ */
+
+size_t
+__malloc_usable_size (void *mem)
+{
+  if (mem == NULL)
+    return 0;
+  rp_ensure_init ();
+  return rpmalloc_usable_size (mem);
+}
+libc_hidden_def (__malloc_usable_size)
+
+int
+__libc_mallopt (int param_number, int value)
+{
+  return malloc_shim_mallopt_ignore (param_number, value);
+}
+#if IS_IN (libc) && !defined (MALLOC_MULTI_BACKEND)
+libc_hidden_def (__libc_mallopt)
+#endif
+
+struct mallinfo
+__libc_mallinfo (void)
+{
+  struct mallinfo info;
+  memset (&info, 0, sizeof (info));
+  return info;
+}
+
+struct mallinfo2
+__libc_mallinfo2 (void)
+{
+  struct mallinfo2 info;
+  memset (&info, 0, sizeof (info));
+  return info;
+}
+libc_hidden_def (__libc_mallinfo2)
+
+int
+__malloc_info (int options __attribute__ ((unused)), FILE *fp)
+{
+  fprintf (fp, "<malloc version=\"rpmalloc\">\n</malloc>\n");
+  return 0;
+}
+
+void
+__malloc_stats (void)
+{
+  rp_ensure_init ();
+  rpmalloc_dump_statistics (stderr);
+}
+
+int
+__malloc_trim (size_t pad __attribute__ ((unused)))
+{
+  rp_ensure_init ();
+  rpmalloc_thread_collect ();
+  return 1;
+}
+
+/* ------------------------------------------------------------------ */
+/* Internal hooks                                                     */
+/* ------------------------------------------------------------------ */
+
+void
+__malloc_fork_lock_parent (void)
+{
+}
+
+void
+__malloc_fork_unlock_parent (void)
+{
+}
+
+void
+__malloc_fork_unlock_child (void)
+{
+}
+
+void
+__malloc_arena_thread_freeres (void)
+{
+  if (rp_thread_inited)
+    {
+      rpmalloc_thread_finalize ();
+      rp_thread_inited = 0;
+    }
+}
+
+void
+__malloc_check_init (void)
+{
+}
+
+void
+__ptmalloc_init (void)
+{
+  rpmalloc_initialize (NULL);
+  rp_global_inited = 1;
+  rpmalloc_thread_initialize ();
+  rp_thread_inited = 1;
+}
+
+/* ------------------------------------------------------------------ */
+/* Compat / version-map aliases                                       */
+/* ------------------------------------------------------------------ */
+
+#ifndef MALLOC_MULTI_BACKEND
+void *__malloc_initialize_hook = NULL;
+void *__free_hook = NULL;
+void *__malloc_hook = NULL;
+void *__realloc_hook = NULL;
+void *__memalign_hook = NULL;
+void *__after_morecore_hook = NULL;
+void *__morecore = NULL;
+#endif
+
+void *
+__glibc_morecore (ptrdiff_t increment __attribute__ ((unused)))
+{
+  return NULL;
+}
+#if SHLIB_COMPAT (libc, GLIBC_2_0, GLIBC_2_34) && !defined (MALLOC_MULTI_BACKEND)
+compat_symbol (libc, __glibc_morecore, __default_morecore, GLIBC_2_0);
+#endif
+
+#if IS_IN (libc) && !defined (MALLOC_MULTI_BACKEND)
+strong_alias (__libc_malloc, malloc)
+strong_alias (__libc_realloc, realloc)
+strong_alias (__libc_free, free)
+weak_alias (__libc_calloc, calloc)
+weak_alias (__libc_memalign, memalign)
+weak_alias (__posix_memalign, posix_memalign)
+weak_alias (__libc_valloc, valloc)
+weak_alias (__libc_pvalloc, pvalloc)
+weak_alias (__malloc_usable_size, malloc_usable_size)
+weak_alias (__malloc_info, malloc_info)
+weak_alias (__libc_mallinfo, mallinfo)
+weak_alias (__libc_mallinfo2, mallinfo2)
+weak_alias (__libc_mallopt, mallopt)
+weak_alias (__malloc_stats, malloc_stats)
+weak_alias (__malloc_trim, malloc_trim)
+#endif
+
+#if SHLIB_COMPAT (libc, GLIBC_2_0, GLIBC_2_26) && !defined (MALLOC_MULTI_BACKEND)
+compat_symbol (libc, __libc_free, cfree, GLIBC_2_0);
+#endif
+
+#ifdef MALLOC_MULTI_BACKEND
+# ifdef MALLOC_MULTI_HIDDEN_PUSHED
+#  pragma pop_macro("weak_function")
+#  pragma pop_macro("libc_hidden_def")
+#  pragma pop_macro("libc_hidden_proto")
+# endif
+#include <malloc-backend.h>
+#include <string.h>
+
+const struct libc_malloc_backend __libc_malloc_backend_rpmalloc =
+{
+  .name = "rpmalloc",
+  .init = __malloc_rpmalloc_ptmalloc_init,
+  .malloc = __malloc_rpmalloc_malloc,
+  .free = __malloc_rpmalloc_free,
+  .realloc = __malloc_rpmalloc_realloc,
+  .calloc = __malloc_rpmalloc_calloc,
+  .memalign = __malloc_rpmalloc_memalign,
+  .valloc = __malloc_rpmalloc_valloc,
+  .pvalloc = __malloc_rpmalloc_pvalloc,
+  .posix_memalign = __malloc_rpmalloc_posix_memalign,
+  .aligned_alloc = __malloc_rpmalloc_aligned_alloc,
+  .free_sized = __malloc_rpmalloc_free_sized,
+  .free_aligned_sized = __malloc_rpmalloc_free_aligned_sized,
+  .usable_size = __malloc_rpmalloc_usable_size,
+  .mallopt = __malloc_rpmalloc_mallopt,
+  .mallinfo = __malloc_rpmalloc_mallinfo,
+  .mallinfo2 = __malloc_rpmalloc_mallinfo2,
+  .malloc_info = __malloc_rpmalloc_malloc_info,
+  .malloc_stats = __malloc_rpmalloc_malloc_stats,
+  .malloc_trim = __malloc_rpmalloc_malloc_trim,
+  .fork_lock_parent = __malloc_rpmalloc_fork_lock_parent,
+  .fork_unlock_parent = __malloc_rpmalloc_fork_unlock_parent,
+  .fork_unlock_child = __malloc_rpmalloc_fork_unlock_child,
+  .arena_thread_freeres = __malloc_rpmalloc_arena_thread_freeres,
+  .check_init = __malloc_rpmalloc_check_init,
+};
+#endif /* MALLOC_MULTI_BACKEND */
