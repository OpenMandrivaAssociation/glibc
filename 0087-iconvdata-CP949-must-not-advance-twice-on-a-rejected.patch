 iconvdata/Makefile          |   5 +-
 iconvdata/tst-iconv-cp949.c | 188 ++++++++++++++++++++++++++++++++++++
 iconvdata/uhc.c             |  10 +-
 4 files changed, 203 insertions(+), 2 deletions(-)
 create mode 100644 iconvdata/tst-iconv-cp949.c

