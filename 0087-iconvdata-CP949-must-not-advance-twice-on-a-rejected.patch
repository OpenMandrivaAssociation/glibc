diff --git a/iconvdata/tst-iconv-cp949.c b/iconvdata/tst-iconv-cp949.c
new file mode 100644
index 00000000..b37c05de
--- /dev/null
+++ b/iconvdata/tst-iconv-cp949.c
@@ -0,0 +1,188 @@
+/* Verify CP949 does not read past the input on an illegal KS C 5601 pair.
+   Copyright (C) 2026 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.
+
+   The GNU C Library is free software; you can redistribute it and/or
+   modify it under the terms of the GNU Lesser General Public
+   License as published by the Free Software Foundation; either
+   version 2.1 of the License, or (at your option) any later version.
+
+   The GNU C Library is distributed in the hope that it will be useful,
+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+   Lesser General Public License for more details.
+
+   You should have received a copy of the GNU Lesser General Public
+   License along with the GNU C Library; if not, see
+   <https://www.gnu.org/licenses/>.  */
+
+#include <errno.h>
+#include <iconv.h>
+#include <string.h>
+
+#include <support/check.h>
+#include <support/next_to_fault.h>
+
+/* KS C 5601 index 165 is U+327E.  ksc5601_to_ucs4 consumes that pair
+   before the UHC/CP949 converter rejects it.  Bug 35016.  */
+
+static void
+test_pair_plain (const char *fromcode)
+{
+  iconv_t cd = iconv_open ("UTF-8", fromcode);
+  TEST_VERIFY_EXIT (cd != (iconv_t) -1);
+  char in[] = { 0xa2, 0xe8 };
+  char out[8];
+  char *ip = in, *op = out;
+  size_t il = sizeof in, ol = sizeof out;
+  errno = 0;
+  TEST_COMPARE (iconv (cd, &ip, &il, &op, &ol), (size_t) -1);
+  TEST_COMPARE (errno, EILSEQ);
+  TEST_VERIFY (ip == in);
+  TEST_COMPARE (il, (size_t) 2);
+  TEST_COMPARE (op, out);
+  TEST_COMPARE (iconv_close (cd), 0);
+}
+
+static void
+test_caller_skip (const char *fromcode)
+{
+  /* A caller that skips the offending sequence on EILSEQ must be
+     pointed at the pair itself, not two bytes past it.  */
+  iconv_t cd = iconv_open ("UTF-8", fromcode);
+  TEST_VERIFY_EXIT (cd != (iconv_t) -1);
+  char in[] = { 0xa2, 0xe8, 'Z' };
+  char out[8];
+  char *ip = in, *op = out;
+  size_t il = sizeof in, ol = sizeof out;
+  errno = 0;
+  TEST_COMPARE (iconv (cd, &ip, &il, &op, &ol), (size_t) -1);
+  TEST_COMPARE (errno, EILSEQ);
+  TEST_VERIFY_EXIT (ip == in);
+  TEST_VERIFY_EXIT (il == 3);
+  ip += 2;
+  il -= 2;
+  op = out;
+  ol = sizeof out;
+  errno = 0;
+  TEST_COMPARE (iconv (cd, &ip, &il, &op, &ol), (size_t) 0);
+  TEST_COMPARE (il, (size_t) 0);
+  TEST_COMPARE_BLOB (out, op - out, "Z", 1);
+  TEST_COMPARE (iconv_close (cd), 0);
+}
+
+static void
+test_ignore_keeps_next (const char *fromcode)
+{
+  iconv_t cd = iconv_open ("UTF-8//IGNORE", fromcode);
+  TEST_VERIFY_EXIT (cd != (iconv_t) -1);
+  char in[] = { 0xa2, 0xe8, 'Z' };
+  char out[8];
+  char *ip = in, *op = out;
+  size_t il = sizeof in, ol = sizeof out;
+  errno = 0;
+  /* glibc still reports EILSEQ: the ignore arm of
+     STANDARD_FROM_LOOP_ERR_HANDLER does not reset result, and iconv()
+     maps __GCONV_ILLEGAL_INPUT to -1 plus EILSEQ.  The following byte
+     must still be converted, and it must not be skipped.  */
+  TEST_COMPARE (iconv (cd, &ip, &il, &op, &ol), (size_t) -1);
+  TEST_COMPARE (errno, EILSEQ);
+  TEST_VERIFY (ip == in + 3);
+  TEST_COMPARE (il, (size_t) 0);
+  TEST_COMPARE_BLOB (out, op - out, "Z", 1);
+  TEST_COMPARE (iconv_close (cd), 0);
+}
+
+static void
+test_trailing_ignore (const char *fromcode)
+{
+  /* The advisory reproducer: the illegal pair is the whole input and
+     //IGNORE is set.  Place it against an inaccessible page.  */
+  struct support_next_to_fault ntf = support_next_to_fault_allocate (2);
+  ntf.buffer[0] = 0xa2;
+  ntf.buffer[1] = 0xe8;
+  iconv_t cd = iconv_open ("UTF-8//IGNORE", fromcode);
+  TEST_VERIFY_EXIT (cd != (iconv_t) -1);
+  char out[8];
+  char *ip = ntf.buffer, *op = out;
+  size_t il = 2, ol = sizeof out;
+  errno = 0;
+  TEST_COMPARE (iconv (cd, &ip, &il, &op, &ol), (size_t) -1);
+  TEST_COMPARE (errno, EILSEQ);
+  TEST_VERIFY (ip == ntf.buffer + 2);
+  TEST_COMPARE (il, (size_t) 0);
+  TEST_COMPARE (op, out);
+  TEST_COMPARE (iconv_close (cd), 0);
+  support_next_to_fault_free (&ntf);
+}
+
+static void
+test_registered_sign (const char *fromcode)
+{
+  /* The neighbouring pair, index 164, is U+00AE and must still convert.  */
+  iconv_t cd = iconv_open ("UTF-8", fromcode);
+  TEST_VERIFY_EXIT (cd != (iconv_t) -1);
+  char in[] = { 0xa2, 0xe7 };
+  char out[8];
+  char *ip = in, *op = out;
+  size_t il = sizeof in, ol = sizeof out;
+  errno = 0;
+  TEST_COMPARE (iconv (cd, &ip, &il, &op, &ol), (size_t) 0);
+  TEST_COMPARE (il, (size_t) 0);
+  TEST_COMPARE_BLOB (out, op - out, "\xc2\xae", 2);
+  TEST_COMPARE (iconv_close (cd), 0);
+}
+
+static void
+test_hangul (const char *fromcode)
+{
+  iconv_t cd = iconv_open ("UTF-8", fromcode);
+  TEST_VERIFY_EXIT (cd != (iconv_t) -1);
+  char in[] = { 0xb0, 0xa1 };
+  char out[8];
+  char *ip = in, *op = out;
+  size_t il = sizeof in, ol = sizeof out;
+  errno = 0;
+  TEST_COMPARE (iconv (cd, &ip, &il, &op, &ol), (size_t) 0);
+  TEST_COMPARE_BLOB (out, op - out, "\xea\xb0\x80", 3);
+  TEST_COMPARE (iconv_close (cd), 0);
+}
+
+static void
+test_hole (const char *fromcode)
+{
+  /* Index 166 is an empty symbol-table slot.  The converter rewinds
+     before reporting it, so the error handler must not rewind again.  */
+  iconv_t cd = iconv_open ("UTF-8//IGNORE", fromcode);
+  TEST_VERIFY_EXIT (cd != (iconv_t) -1);
+  char in[] = { 0xa2, 0xe9, 'Q' };
+  char out[8];
+  char *ip = in, *op = out;
+  size_t il = sizeof in, ol = sizeof out;
+  errno = 0;
+  TEST_COMPARE (iconv (cd, &ip, &il, &op, &ol), (size_t) -1);
+  TEST_COMPARE (errno, EILSEQ);
+  TEST_VERIFY (ip == in + 3);
+  TEST_COMPARE (il, (size_t) 0);
+  TEST_COMPARE_BLOB (out, op - out, "Q", 1);
+  TEST_COMPARE (iconv_close (cd), 0);
+}
+
+static int
+do_test (void)
+{
+  static const char *const codes[] = { "CP949", "UHC" };
+  for (size_t i = 0; i < sizeof (codes) / sizeof (codes[0]); ++i)
+    {
+      test_pair_plain (codes[i]);
+      test_caller_skip (codes[i]);
+      test_ignore_keeps_next (codes[i]);
+      test_trailing_ignore (codes[i]);
+      test_registered_sign (codes[i]);
+      test_hangul (codes[i]);
+      test_hole (codes[i]);
+    }
+  return 0;
+}
+
+#include <support/test-driver.c>
diff --git a/iconvdata/uhc.c b/iconvdata/uhc.c
index 8477aeb0..e1ca8b96 100644
--- a/iconvdata/uhc.c
+++ b/iconvdata/uhc.c
@@ -3137,7 +3137,15 @@ static const char uhc_hangul_from_ucs[11172][2] =
 	    if (__builtin_expect (ch == __UNKNOWN_10646_CHAR, 0)	      \
 		|| __builtin_expect (ch == 0x327e, 0))			      \
 	      {								      \
-		/* Illegal.  */						      \
+		/* Illegal.  ksc5601_to_ucs4 consumes a well-formed pair	      \
+		   before returning U+327E, which this converter rejects.	      \
+		   Roll that pair back so the error handler skips it once.	      \
+		   With //IGNORE, skipping an already-consumed pair reads	      \
+		   past the end of the buffer (CVE-2026-121757, bug 35016).      \
+		   __UNKNOWN_10646_CHAR is returned only when the pair was	      \
+		   not consumed.  */						      \
+		if (ch == 0x327e)						      \
+		  inptr -= 2;							      \
 		STANDARD_FROM_LOOP_ERR_HANDLER (2);			      \
 	      }								      \
 	  }								      \
-- 
2.56.1

