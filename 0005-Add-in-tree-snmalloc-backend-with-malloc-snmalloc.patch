+/* C++ compilation unit for snmalloc allocator embedded in glibc.
+   Copyright (C) 2026 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.
+
+   The GNU C Library is free software; you can redistribute it and/or
+   modify it under the terms of the GNU Lesser General Public License as
+   published by the Free Software Foundation; either version 2.1 of the
+   License, or (at your option) any later version.
+
+   The GNU C Library is distributed in the hope that it will be useful,
+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+   Lesser General Public License for more details.
+
+   You should have received a copy of the GNU Lesser General Public
+   License along with the GNU C Library; see the file COPYING.LIB.  If
+   not, see <https://www.gnu.org/licenses/>.  */
+
+/* This file compiles snmalloc's C++ core directly into glibc,
+   eliminating the need for an external CMake build and removing
+   the runtime dependency on libstdc++.
+
+   Key build flags (set via CPPFLAGS in malloc/Makefile):
+   - SNMALLOC_USE_SELF_VENDORED_STL: use snmalloc's own STL replacements
+   - SNMALLOC_USE_CXX11_THREAD_ATEXIT_DIRECT: use glibc's __cxa_thread_atexit_impl
+   - SNMALLOC_STATIC_LIBRARY_PREFIX=sn_: export sn_* prefixed C symbols
+   - NDEBUG: release build
+   - SNMALLOC_PLATFORM_HAS_GETENTROPY: glibc provides getentropy
+   - SNMALLOC_HAS_LINUX_RANDOM_H: linux/random.h available
+   - SNMALLOC_HAS_LINUX_FUTEX_H: linux/futex.h available  */
+
+/* Pull in the snmalloc library.  This is a header-only C++ library;
+   the override *.cc files provide the C entry points.  */
+
+/* Include the malloc override - this provides sn_malloc, sn_free, etc.  */
+#include "snmalloc/override/malloc.cc"
+
+/* Include the memcpy override - this provides sn_memcpy.  */
+#include "snmalloc/override/memcpy.cc"
+
+/* Provide the pure-virtual handler that the C++ runtime normally supplies.
+   Since we compile with -fno-rtti -fno-exceptions and -nostdlib, we need
+   to provide this ourselves in case any vtable contains a pure virtual.  */
+extern "C" void __cxa_pure_virtual ()
+{
+  __builtin_trap ();
+}
+
+extern "C" void __sn_initialize (void)
+{
+  snmalloc::StandardConfigClientMeta<>::ensure_init();
+}
diff --git a/malloc/malloc-snmalloc.c b/malloc/malloc-snmalloc.c
new file mode 100644
index 0000000..5f92853
--- /dev/null
+++ b/malloc/malloc-snmalloc.c
@@ -0,0 +1,430 @@
+/* Shim to use snmalloc as the malloc implementation inside glibc.
+   Copyright (C) 2026 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.
+
+   The GNU C Library is free software; you can redistribute it and/or
+   modify it under the terms of the GNU Lesser General Public License as
+   published by the Free Software Foundation; either version 2.1 of the
+   License, or (at your option) any later version.
+
+   The GNU C Library is distributed in the hope that it will be useful,
+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+   Lesser General Public License for more details.
+
+   You should have received a copy of the GNU Lesser General Public
+   License along with the GNU C Library; see the file COPYING.LIB.  If
+   not, see <https://www.gnu.org/licenses/>.  */
+
+/* snmalloc is a C++ allocator.  The implementation lives in
+   malloc/snmalloc/ and is compiled by malloc-snmalloc-impl.cc, which
+   exports sn_* prefixed C functions.  */
+
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+#include <malloc.h>
+#include <libc-symbols.h>
+#include <shlib-compat.h>
+#include <malloc-internal.h>
+#include "malloc-shim-compat.h"
+
+#ifdef MALLOC_MULTI_BACKEND
+# define __libc_malloc __malloc_snmalloc_malloc
+# define __libc_free __malloc_snmalloc_free
+# define __libc_realloc __malloc_snmalloc_realloc
+# define __libc_calloc __malloc_snmalloc_calloc
+# define __libc_memalign __malloc_snmalloc_memalign
+# define __libc_valloc __malloc_snmalloc_valloc
+# define __libc_pvalloc __malloc_snmalloc_pvalloc
+# define __posix_memalign __malloc_snmalloc_posix_memalign
+# define aligned_alloc __malloc_snmalloc_aligned_alloc
+# define free_sized __malloc_snmalloc_free_sized
+# define free_aligned_sized __malloc_snmalloc_free_aligned_sized
+# define __malloc_usable_size __malloc_snmalloc_usable_size
+# define __libc_mallopt __malloc_snmalloc_mallopt
+# define __libc_mallinfo __malloc_snmalloc_mallinfo
+# define __libc_mallinfo2 __malloc_snmalloc_mallinfo2
+# define __malloc_info __malloc_snmalloc_malloc_info
+# define __malloc_stats __malloc_snmalloc_malloc_stats
+# define __malloc_trim __malloc_snmalloc_malloc_trim
+# define __malloc_fork_lock_parent __malloc_snmalloc_fork_lock_parent
+# define __malloc_fork_unlock_parent __malloc_snmalloc_fork_unlock_parent
+# define __malloc_fork_unlock_child __malloc_snmalloc_fork_unlock_child
+# define __malloc_arena_thread_freeres __malloc_snmalloc_arena_thread_freeres
+# define __malloc_check_init __malloc_snmalloc_check_init
+# define __ptmalloc_init __malloc_snmalloc_ptmalloc_init
+# define __glibc_morecore __malloc_snmalloc_morecore
+# pragma push_macro("libc_hidden_proto")
+# pragma push_macro("libc_hidden_def")
+# pragma push_macro("weak_function")
+# undef libc_hidden_proto
+# define libc_hidden_proto(...) /* nothing */
+# undef libc_hidden_def
+# define libc_hidden_def(...) /* nothing */
+# undef weak_function
+# define weak_function /* nothing */
+# define MALLOC_MULTI_HIDDEN_PUSHED 1
+#endif
+
+
+/* Declarations for the sn_* prefixed snmalloc API.
+   Only the subset actually used by this shim is declared.
+   Alignment-related functions (aligned_alloc, valloc, pvalloc) are
+   implemented in this shim on top of sn_memalign to match glibc's
+   expected semantics (e.g. rounding non-power-of-2 alignments,
+   overflow checking in pvalloc, C23 aligned_alloc rules).  */
+extern void *sn_malloc (size_t);
+extern void  sn_free (void *);
+extern void *sn_realloc (void *, size_t);
+extern void *sn_calloc (size_t, size_t);
+extern void *sn_memalign (size_t, size_t);
+extern int   sn_posix_memalign (void **, size_t, size_t);
+extern size_t sn_malloc_usable_size (const void *);
+
+/* Hidden prototypes.  */
+void *__libc_malloc (size_t);
+libc_hidden_proto (__libc_malloc)
+void __libc_free (void *);
+libc_hidden_proto (__libc_free)
+void *__libc_realloc (void *, size_t);
+libc_hidden_proto (__libc_realloc)
+void *__libc_memalign (size_t, size_t);
+libc_hidden_proto (__libc_memalign)
+struct mallinfo2 __libc_mallinfo2 (void);
+libc_hidden_proto (__libc_mallinfo2)
+int __libc_mallopt (int, int);
+libc_hidden_proto (__libc_mallopt)
+
+void *__libc_calloc (size_t, size_t);
+libc_hidden_proto (__libc_calloc)
+void *__libc_valloc (size_t);
+libc_hidden_proto (__libc_valloc)
+void *__libc_pvalloc (size_t);
+libc_hidden_proto (__libc_pvalloc)
+int __posix_memalign (void **, size_t, size_t);
+libc_hidden_proto (__posix_memalign)
+size_t __malloc_usable_size (void *);
+libc_hidden_proto (__malloc_usable_size)
+
+/* ------------------------------------------------------------------ */
+/* Core allocation entry points                                       */
+/* ------------------------------------------------------------------ */
+
+void *
+__libc_malloc (size_t bytes)
+{
+  if (malloc_shim_size_too_large (bytes))
+    return malloc_shim_fail_oom ();
+  return MALLOC_SHIM_CALL (sn_malloc (bytes));
+}
+libc_hidden_def (__libc_malloc)
+
+void
+__libc_free (void *mem)
+{
+  if (mem == NULL)
+    return;
+  MALLOC_SHIM_FREE (sn_free (mem));
+}
+libc_hidden_def (__libc_free)
+
+void *
+__libc_realloc (void *oldmem, size_t bytes)
+{
+  void *p;
+  if (bytes == 0)
+    {
+      if (oldmem != NULL)
+	{
+	  MALLOC_SHIM_FREE (sn_free (oldmem));
+	  return NULL;
+	}
+      return MALLOC_SHIM_CALL (sn_malloc (0));
+    }
+  if (malloc_shim_size_too_large (bytes))
+    return malloc_shim_fail_oom ();
+  if (oldmem == NULL)
+      if (oldmem == NULL)
+    return MALLOC_SHIM_CALL (sn_malloc (bytes));
+  /* Shrink-in-place: glibc leaves the block unmoved when the new size
+     fits in the existing usable region (tst-realloc).  */
+  if (bytes <= sn_malloc_usable_size (oldmem))
+    return oldmem;
+  p = sn_realloc (oldmem, bytes);
+  if (p == NULL)
+    __set_errno (ENOMEM);
+  return p;
+}
+libc_hidden_def (__libc_realloc)
+
+void *
+__libc_calloc (size_t n, size_t elem_size)
+{
+  size_t bytes;
+  if (__builtin_mul_overflow (n, elem_size, &bytes) || malloc_shim_size_too_large (bytes))
+    return malloc_shim_fail_oom ();
+  return MALLOC_SHIM_CALL (sn_calloc (n, elem_size));
+}
+libc_hidden_def (__libc_calloc)
+
+void *
+__libc_memalign (size_t alignment, size_t bytes)
+{
+  alignment = malloc_shim_align_pow2 (alignment);
+  if (alignment == 0 || malloc_shim_size_too_large (bytes)
+      || malloc_shim_size_too_large (alignment))
+    {
+      __set_errno (alignment == 0 ? EINVAL : ENOMEM);
+      return NULL;
+    }
+  return MALLOC_SHIM_CALL (sn_memalign (alignment, bytes));
+}
+libc_hidden_def (__libc_memalign)
+
+void *
+__libc_valloc (size_t bytes)
+{
+  return __libc_memalign (__getpagesize (), bytes);
+}
+libc_hidden_def (__libc_valloc)
+
+void *
+__libc_pvalloc (size_t bytes)
+{
+  size_t rounded = malloc_shim_pvalloc_size (bytes);
+  if (rounded == 0)
+    return malloc_shim_fail_oom ();
+  return __libc_memalign (__getpagesize (), rounded);
+}
+libc_hidden_def (__libc_pvalloc)
+
+int
+__posix_memalign (void **memptr, size_t alignment, size_t size)
+{
+  void *p;
+  if (memptr == NULL
+      || alignment == 0
+      || (alignment & (alignment - 1)) != 0
+      || alignment % sizeof (void *) != 0)
+    return EINVAL;
+  if (malloc_shim_size_too_large (size))
+    return ENOMEM;
+  p = sn_memalign (alignment, size);
+  if (p == NULL)
+    return ENOMEM;
+  *memptr = p;
+  return 0;
+}
+libc_hidden_def (__posix_memalign)
+
+void *
+weak_function
+aligned_alloc (size_t alignment, size_t bytes)
+{
+  if (alignment == 0 || (alignment & (alignment - 1)) != 0)
+    {
+      __set_errno (EINVAL);
+      return NULL;
+    }
+  if (malloc_shim_size_too_large (bytes) || malloc_shim_size_too_large (alignment))
+    return malloc_shim_fail_oom ();
+  return MALLOC_SHIM_CALL (sn_memalign (alignment, bytes));
+}
+
+void
+weak_function
+free_sized (void *ptr, size_t size __attribute_maybe_unused__)
+{
+  if (ptr == NULL)
+    return;
+  MALLOC_SHIM_FREE (sn_free (ptr));
+}
+
+void
+weak_function
+free_aligned_sized (void *ptr, size_t alignment __attribute_maybe_unused__,
+		    size_t size __attribute_maybe_unused__)
+{
+  if (ptr == NULL)
+    return;
+  MALLOC_SHIM_FREE (sn_free (ptr));
+}
+
+/* Extended / informational entry points                              */
+/* ------------------------------------------------------------------ */
+
+size_t
+__malloc_usable_size (void *mem)
+{
+  if (mem == NULL)
+    return 0;
+  return sn_malloc_usable_size (mem);
+}
+libc_hidden_def (__malloc_usable_size)
+
+int
+__libc_mallopt (int param_number, int value)
+{
+  return malloc_shim_mallopt_ignore (param_number, value);
+}
+#if IS_IN (libc) && !defined (MALLOC_MULTI_BACKEND)
+libc_hidden_def (__libc_mallopt)
+#endif
+
+struct mallinfo
+__libc_mallinfo (void)
+{
+  struct mallinfo info;
+  memset (&info, 0, sizeof (info));
+  return info;
+}
+
+struct mallinfo2
+__libc_mallinfo2 (void)
+{
+  struct mallinfo2 info;
+  memset (&info, 0, sizeof (info));
+  return info;
+}
+libc_hidden_def (__libc_mallinfo2)
+
+int
+__malloc_info (int options __attribute__ ((unused)), FILE *fp)
+{
+  fprintf (fp, "<malloc version=\"snmalloc\">\n</malloc>\n");
+  return 0;
+}
+
+void
+__malloc_stats (void)
+{
+}
+
+int
+__malloc_trim (size_t pad __attribute__ ((unused)))
+{
+  return 1;
+}
+
+/* ------------------------------------------------------------------ */
+/* Internal hooks                                                     */
+/* ------------------------------------------------------------------ */
+
+void
+__malloc_fork_lock_parent (void)
+{
+}
+
+void
+__malloc_fork_unlock_parent (void)
+{
+}
+
+void
+__malloc_fork_unlock_child (void)
+{
+}
+
+void
+__malloc_arena_thread_freeres (void)
+{
+}
+
+void
+__malloc_check_init (void)
+{
+}
+
+extern void __sn_initialize (void);
+
+void
+__ptmalloc_init (void)
+{
+	__sn_initialize ();
+}
+
+/* ------------------------------------------------------------------ */
+/* Compat / version-map aliases                                       */
+/* ------------------------------------------------------------------ */
+
+#ifndef MALLOC_MULTI_BACKEND
+void *__malloc_initialize_hook = NULL;
+void *__free_hook = NULL;
+void *__malloc_hook = NULL;
+void *__realloc_hook = NULL;
+void *__memalign_hook = NULL;
+void *__after_morecore_hook = NULL;
+void *__morecore = NULL;
+#endif
+
+void *
+__glibc_morecore (ptrdiff_t increment __attribute__ ((unused)))
+{
+  return NULL;
+}
+#if SHLIB_COMPAT (libc, GLIBC_2_0, GLIBC_2_34) && !defined (MALLOC_MULTI_BACKEND)
+compat_symbol (libc, __glibc_morecore, __default_morecore, GLIBC_2_0);
+#endif
+
