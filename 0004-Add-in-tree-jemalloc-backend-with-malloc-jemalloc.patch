From 1fd92a822b3b50efa98281999f598e34dbac9a61 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bernhard=20Rosenkr=C3=A4nzer?= <bero@lindev.ch>
Date: Wed, 19 Aug 2026 19:00:00 +0200
Subject: [PATCH 04/13] Add jemalloc backend glue (--with-malloc=jemalloc)

Shim only.  Configured jemalloc sources come from the jemalloc tarball
unpacked into malloc/jemalloc/ in %prep.  The tarball's
jemalloc_internal_defs.h is x86_64 configure output; Source29
(0016-jemalloc-portable-configure-defs.patch) overlays portable
spinwait / VA / sizeof / rdtscp / __int128 defines after unpack.
---
 malloc/malloc-jemalloc.c | 472 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 472 insertions(+)
 create mode 100644 malloc/malloc-jemalloc.c

diff --git a/malloc/malloc-jemalloc.c b/malloc/malloc-jemalloc.c
new file mode 100644
index 0000000..c2cc337
--- /dev/null
+++ b/malloc/malloc-jemalloc.c
@@ -0,0 +1,472 @@
+/* Shim to use jemalloc as the malloc implementation inside glibc.
+   Copyright (C) 2026 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.
+
+   The GNU C Library is free software; you can redistribute it and/or
+   modify it under the terms of the GNU Lesser General Public License as
+   published by the Free Software Foundation; either version 2.1 of the
+   License, or (at your option) any later version.
+
+   The GNU C Library is distributed in the hope that it will be useful,
+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+   Lesser General Public License for more details.
+
+   You should have received a copy of the GNU Lesser General Public
+   License along with the GNU C Library; see the file COPYING.LIB.  If
+   not, see <https://www.gnu.org/licenses/>.  */
+
+/* This file provides the __libc_* malloc entry points expected by the
+   rest of glibc, implemented on top of jemalloc.  It is compiled
+   instead of malloc.c when --with-malloc=jemalloc is used.
+
+   The jemalloc implementation lives in malloc/jemalloc/ and is compiled
+   in-tree with the je_ prefix.  This shim forwards to the je_* API.  */
+
+#include <errno.h>
+#include <unistd.h>
+#include <stdio.h>
+#include <string.h>
+#include <malloc.h>
+#include <libc-symbols.h>
+#include <shlib-compat.h>
+#include <malloc-internal.h>
+#include "malloc-shim-compat.h"
+
+#ifdef MALLOC_MULTI_BACKEND
+# define __libc_malloc __malloc_jemalloc_malloc
+# define __libc_free __malloc_jemalloc_free
+# define __libc_realloc __malloc_jemalloc_realloc
+# define __libc_calloc __malloc_jemalloc_calloc
+# define __libc_memalign __malloc_jemalloc_memalign
+# define __libc_valloc __malloc_jemalloc_valloc
+# define __libc_pvalloc __malloc_jemalloc_pvalloc
+# define __posix_memalign __malloc_jemalloc_posix_memalign
+# define aligned_alloc __malloc_jemalloc_aligned_alloc
+# define free_sized __malloc_jemalloc_free_sized
+# define free_aligned_sized __malloc_jemalloc_free_aligned_sized
+# define __malloc_usable_size __malloc_jemalloc_usable_size
+# define __libc_mallopt __malloc_jemalloc_mallopt
+# define __libc_mallinfo __malloc_jemalloc_mallinfo
+# define __libc_mallinfo2 __malloc_jemalloc_mallinfo2
+# define __malloc_info __malloc_jemalloc_malloc_info
+# define __malloc_stats __malloc_jemalloc_malloc_stats
+# define __malloc_trim __malloc_jemalloc_malloc_trim
+# define __malloc_fork_lock_parent __malloc_jemalloc_fork_lock_parent
+# define __malloc_fork_unlock_parent __malloc_jemalloc_fork_unlock_parent
+# define __malloc_fork_unlock_child __malloc_jemalloc_fork_unlock_child
+# define __malloc_arena_thread_freeres __malloc_jemalloc_arena_thread_freeres
+# define __malloc_check_init __malloc_jemalloc_check_init
+# define __ptmalloc_init __malloc_jemalloc_ptmalloc_init
+# define __glibc_morecore __malloc_jemalloc_morecore
+# pragma push_macro("libc_hidden_proto")
+# pragma push_macro("libc_hidden_def")
+# pragma push_macro("weak_function")
+# undef libc_hidden_proto
+# define libc_hidden_proto(...) /* nothing */
+# undef libc_hidden_def
+# define libc_hidden_def(...) /* nothing */
+# undef weak_function
+# define weak_function /* nothing */
+# define MALLOC_MULTI_HIDDEN_PUSHED 1
+#endif
+
+
+/* Provide atexit symbol that jemalloc needs.  In glibc, atexit is
+   implemented via __cxa_atexit in stdlib/atexit.c, but jemalloc
+   references it directly.  In the static libc.a, atexit.o is already
+   present, so we must not duplicate it.  */
+#if IS_IN (libc) && defined SHARED
+extern int __cxa_atexit (void (*func) (void *), void *arg, void *dso_handle);
+extern void *__dso_handle __attribute__ ((weak));
+
+__attribute__ ((weak)) int atexit (void (*func) (void))
+{
+  return __cxa_atexit ((void (*) (void *)) func, 0,
+                       &__dso_handle == 0 ? 0 : __dso_handle);
+}
+#endif
+
+/* Provide pthread_atfork for jemalloc.  Inside libc the symbol is
+   versioned; we forward to the internal __register_atfork.
+   In the static build, pthread_atfork is provided by nptl/
+   and __dso_handle may not be available, so guard this.  */
+extern int __register_atfork (void (*) (void), void (*) (void),
+                              void (*) (void), void *);
+#if IS_IN (libc) && defined SHARED
+__attribute__ ((weak)) int pthread_atfork (void (*prepare) (void), void (*parent) (void),
+                    void (*child) (void))
+{
+  return __register_atfork (prepare, parent, child, &__dso_handle);
+}
+#endif
+
+/* Declarations for the je_* prefixed jemalloc API.  */
+extern void *je_malloc (size_t);
+extern void je_free (void *);
+extern void *je_realloc (void *, size_t);
+extern void *je_calloc (size_t, size_t);
+extern void *je_memalign (size_t, size_t);
+extern void *je_aligned_alloc (size_t, size_t);
+extern int   je_posix_memalign (void **, size_t, size_t);
+extern void *je_valloc (size_t);
+extern size_t je_malloc_usable_size (const void *);
+extern void je_malloc_stats_print (void (*)(void *, const char *),
+                                   void *, const char *);
+extern void je_dallocx (void *, int);
+extern void je_free_sized (void *, size_t);
+extern void je_free_aligned_sized (void *, size_t, size_t);
+
+/* Hidden prototypes.  */
+void *__libc_malloc (size_t);
+libc_hidden_proto (__libc_malloc)
+void __libc_free (void *);
+libc_hidden_proto (__libc_free)
+void *__libc_realloc (void *, size_t);
+libc_hidden_proto (__libc_realloc)
+void *__libc_memalign (size_t, size_t);
+libc_hidden_proto (__libc_memalign)
+struct mallinfo2 __libc_mallinfo2 (void);
+libc_hidden_proto (__libc_mallinfo2)
+int __libc_mallopt (int, int);
+libc_hidden_proto (__libc_mallopt)
+
+void *__libc_calloc (size_t, size_t);
+libc_hidden_proto (__libc_calloc)
+void *__libc_valloc (size_t);
+libc_hidden_proto (__libc_valloc)
+void *__libc_pvalloc (size_t);
+libc_hidden_proto (__libc_pvalloc)
+int __posix_memalign (void **, size_t, size_t);
+libc_hidden_proto (__posix_memalign)
+size_t __malloc_usable_size (void *);
+libc_hidden_proto (__malloc_usable_size)
+
+/* ------------------------------------------------------------------ */
+/* Core allocation entry points                                       */
+/* ------------------------------------------------------------------ */
+
+void *
+__libc_malloc (size_t bytes)
+{
+  if (malloc_shim_size_too_large (bytes))
+    return malloc_shim_fail_oom ();
+  return MALLOC_SHIM_CALL (je_malloc (bytes));
+}
+libc_hidden_def (__libc_malloc)
+
+void
+__libc_free (void *mem)
+{
+  if (mem == NULL)
+    return;
+  MALLOC_SHIM_FREE (je_free (mem));
+}
+libc_hidden_def (__libc_free)
+
+void *
+__libc_realloc (void *oldmem, size_t bytes)
+{
+  void *p;
+  if (bytes == 0)
+    {
+      if (oldmem != NULL)
+	{
+	  MALLOC_SHIM_FREE (je_free (oldmem));
+	  return NULL;
+	}
+      return MALLOC_SHIM_CALL (je_malloc (0));
+    }
+  if (malloc_shim_size_too_large (bytes))
+    return malloc_shim_fail_oom ();
+  if (oldmem == NULL)
+      if (oldmem == NULL)
+    return MALLOC_SHIM_CALL (je_malloc (bytes));
+  /* Shrink-in-place: glibc leaves the block unmoved when the new size
+     fits in the existing usable region (tst-realloc).  */
+  if (bytes <= je_malloc_usable_size (oldmem))
+    return oldmem;
+  p = je_realloc (oldmem, bytes);
+  if (p == NULL)
+    __set_errno (ENOMEM);
+  return p;
+}
+libc_hidden_def (__libc_realloc)
+
+void *
+__libc_calloc (size_t n, size_t elem_size)
+{
+  size_t bytes;
+  if (__builtin_mul_overflow (n, elem_size, &bytes) || malloc_shim_size_too_large (bytes))
+    return malloc_shim_fail_oom ();
+  return MALLOC_SHIM_CALL (je_calloc (n, elem_size));
+}
+libc_hidden_def (__libc_calloc)
+
+void *
+__libc_memalign (size_t alignment, size_t bytes)
+{
+  alignment = malloc_shim_align_pow2 (alignment);
+  if (alignment == 0 || malloc_shim_size_too_large (bytes)
+      || malloc_shim_size_too_large (alignment))
+    {
+      __set_errno (alignment == 0 ? EINVAL : ENOMEM);
+      return NULL;
+    }
+  return MALLOC_SHIM_CALL (je_memalign (alignment, bytes));
+}
+libc_hidden_def (__libc_memalign)
+
+void *
+__libc_valloc (size_t bytes)
+{
+  return __libc_memalign (__getpagesize (), bytes);
+}
+libc_hidden_def (__libc_valloc)
+
+void *
+__libc_pvalloc (size_t bytes)
+{
+  size_t rounded = malloc_shim_pvalloc_size (bytes);
+  if (rounded == 0)
+    return malloc_shim_fail_oom ();
+  return __libc_memalign (__getpagesize (), rounded);
+}
+libc_hidden_def (__libc_pvalloc)
+
+int
+__posix_memalign (void **memptr, size_t alignment, size_t size)
+{
+  void *p;
+  if (memptr == NULL
+      || alignment == 0
+      || (alignment & (alignment - 1)) != 0
+      || alignment % sizeof (void *) != 0)
+    return EINVAL;
+  if (malloc_shim_size_too_large (size))
+    return ENOMEM;
+  p = je_memalign (alignment, size);
+  if (p == NULL)
+    return ENOMEM;
+  *memptr = p;
+  return 0;
+}
+libc_hidden_def (__posix_memalign)
+
+void *
+weak_function
+aligned_alloc (size_t alignment, size_t bytes)
+{
+  if (alignment == 0 || (alignment & (alignment - 1)) != 0)
+    {
+      __set_errno (EINVAL);
+      return NULL;
+    }
+  if (malloc_shim_size_too_large (bytes) || malloc_shim_size_too_large (alignment))
+    return malloc_shim_fail_oom ();
+  return MALLOC_SHIM_CALL (je_memalign (alignment, bytes));
+}
+
+void
+weak_function
+free_sized (void *ptr, size_t size __attribute_maybe_unused__)
+{
+  if (ptr == NULL)
+    return;
+  MALLOC_SHIM_FREE (je_free (ptr));
+}
+
+void
+weak_function
+free_aligned_sized (void *ptr, size_t alignment __attribute_maybe_unused__,
+		    size_t size __attribute_maybe_unused__)
+{
+  if (ptr == NULL)
+    return;
+  MALLOC_SHIM_FREE (je_free (ptr));
+}
+
+/* Extended / informational entry points                              */
+/* ------------------------------------------------------------------ */
+
+size_t
+__malloc_usable_size (void *mem)
+{
+  if (mem == NULL)
+    return 0;
+  return je_malloc_usable_size (mem);
+}
+libc_hidden_def (__malloc_usable_size)
+
+int
+__libc_mallopt (int param_number, int value)
+{
+  return malloc_shim_mallopt_ignore (param_number, value);
+}
+#if IS_IN (libc) && !defined (MALLOC_MULTI_BACKEND)
+libc_hidden_def (__libc_mallopt)
+#endif
+
+struct mallinfo
+__libc_mallinfo (void)
+{
+  struct mallinfo info;
+  memset (&info, 0, sizeof (info));
+  return info;
+}
+
+struct mallinfo2
+__libc_mallinfo2 (void)
+{
+  struct mallinfo2 info;
+  memset (&info, 0, sizeof (info));
+  return info;
+}
+libc_hidden_def (__libc_mallinfo2)
+
+int
+__malloc_info (int options __attribute__ ((unused)), FILE *fp)
+{
+  fprintf (fp, "<malloc version=\"jemalloc\">\n</malloc>\n");
+  return 0;
+}
+
+static void
+je_stats_write_cb (void *cbopaque, const char *s)
+{
+  fputs (s, cbopaque ? (FILE *) cbopaque : stderr);
+}
+
+void
+__malloc_stats (void)
+{
+  je_malloc_stats_print (je_stats_write_cb, stderr, NULL);
+}
+
+int
+__malloc_trim (size_t pad __attribute__ ((unused)))
+{
+  /* jemalloc has arena.purge mallctl, but calling it from here
+     is complex.  Return 1 to indicate "success" (no-op).  */
+  return 1;
+}
+
+/* ------------------------------------------------------------------ */
+/* Internal hooks expected by the rest of glibc (pthreads, fork, ...)  */
+/* ------------------------------------------------------------------ */
+
+void
+__malloc_fork_lock_parent (void)
+{
+  /* jemalloc handles fork safety internally via
+     jemalloc_prefork/jemalloc_postfork hooks.  */
+}
+
+void
+__malloc_fork_unlock_parent (void)
+{
+}
+
+void
+__malloc_fork_unlock_child (void)
+{
+}
+
+void
+__malloc_arena_thread_freeres (void)
+{
+}
+
+void
+__malloc_check_init (void)
+{
+}
+
+void
+__ptmalloc_init (void)
+{
+}
+
+/* ------------------------------------------------------------------ */
+/* Compat / version-map aliases                                       */
+/* ------------------------------------------------------------------ */
+
+#ifndef MALLOC_MULTI_BACKEND
+void *__malloc_initialize_hook = NULL;
+void *__free_hook = NULL;
+void *__malloc_hook = NULL;
+void *__realloc_hook = NULL;
+void *__memalign_hook = NULL;
+void *__after_morecore_hook = NULL;
+void *__morecore = NULL;
+#endif
+
+void *
+__glibc_morecore (ptrdiff_t increment __attribute__ ((unused)))
+{
+  return NULL;
+}
+#if SHLIB_COMPAT (libc, GLIBC_2_0, GLIBC_2_34) && !defined (MALLOC_MULTI_BACKEND)
+compat_symbol (libc, __glibc_morecore, __default_morecore, GLIBC_2_0);
+#endif
+
+#if IS_IN (libc) && !defined (MALLOC_MULTI_BACKEND)
+strong_alias (__libc_malloc, malloc)
+strong_alias (__libc_realloc, realloc)
+strong_alias (__libc_free, free)
+weak_alias (__libc_calloc, calloc)
+weak_alias (__libc_memalign, memalign)
+weak_alias (__posix_memalign, posix_memalign)
+weak_alias (__libc_valloc, valloc)
+weak_alias (__libc_pvalloc, pvalloc)
+weak_alias (__malloc_usable_size, malloc_usable_size)
+weak_alias (__malloc_info, malloc_info)
+weak_alias (__libc_mallinfo, mallinfo)
+weak_alias (__libc_mallinfo2, mallinfo2)
+weak_alias (__libc_mallopt, mallopt)
+weak_alias (__malloc_stats, malloc_stats)
+weak_alias (__malloc_trim, malloc_trim)
+#endif
+
+#if SHLIB_COMPAT (libc, GLIBC_2_0, GLIBC_2_26) && !defined (MALLOC_MULTI_BACKEND)
+compat_symbol (libc, __libc_free, cfree, GLIBC_2_0);
+#endif
+
+#ifdef MALLOC_MULTI_BACKEND
+# ifdef MALLOC_MULTI_HIDDEN_PUSHED
+#  pragma pop_macro("weak_function")
+#  pragma pop_macro("libc_hidden_def")
+#  pragma pop_macro("libc_hidden_proto")
+# endif
+#include <malloc-backend.h>
+#include <string.h>
+
+const struct libc_malloc_backend __libc_malloc_backend_jemalloc =
+{
+  .name = "jemalloc",
+  .init = __malloc_jemalloc_ptmalloc_init,
+  .malloc = __malloc_jemalloc_malloc,
+  .free = __malloc_jemalloc_free,
+  .realloc = __malloc_jemalloc_realloc,
+  .calloc = __malloc_jemalloc_calloc,
+  .memalign = __malloc_jemalloc_memalign,
+  .valloc = __malloc_jemalloc_valloc,
+  .pvalloc = __malloc_jemalloc_pvalloc,
+  .posix_memalign = __malloc_jemalloc_posix_memalign,
+  .aligned_alloc = __malloc_jemalloc_aligned_alloc,
+  .free_sized = __malloc_jemalloc_free_sized,
+  .free_aligned_sized = __malloc_jemalloc_free_aligned_sized,
+  .usable_size = __malloc_jemalloc_usable_size,
+  .mallopt = __malloc_jemalloc_mallopt,
+  .mallinfo = __malloc_jemalloc_mallinfo,
+  .mallinfo2 = __malloc_jemalloc_mallinfo2,
+  .malloc_info = __malloc_jemalloc_malloc_info,
+  .malloc_stats = __malloc_jemalloc_malloc_stats,
+  .malloc_trim = __malloc_jemalloc_malloc_trim,
+  .fork_lock_parent = __malloc_jemalloc_fork_lock_parent,
+  .fork_unlock_parent = __malloc_jemalloc_fork_unlock_parent,
+  .fork_unlock_child = __malloc_jemalloc_fork_unlock_child,
+  .arena_thread_freeres = __malloc_jemalloc_arena_thread_freeres,
+  .check_init = __malloc_jemalloc_check_init,
+};
+#endif /* MALLOC_MULTI_BACKEND */
