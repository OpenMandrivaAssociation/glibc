Date: Wed, 19 Aug 2026 19:00:00 +0200
Subject: [PATCH 08/13] Add hardened_malloc backend glue
 (--with-malloc=hardened-malloc)

Shim and amalgamation TU only.  Upstream sources come from the
hardened_malloc tarball unpacked into malloc/hardened_malloc/ in %prep.
---
 malloc/malloc-hardened-malloc-impl.c |  16 +
 malloc/malloc-hardened-malloc.c      | 421 +++++++++++++++++++++++++++
 2 files changed, 437 insertions(+)
 create mode 100644 malloc/malloc-hardened-malloc-impl.c
 create mode 100644 malloc/malloc-hardened-malloc.c

diff --git a/malloc/malloc-hardened-malloc-impl.c b/malloc/malloc-hardened-malloc-impl.c
new file mode 100644
index 0000000..574cc37
--- /dev/null
+++ b/malloc/malloc-hardened-malloc-impl.c
@@ -0,0 +1,16 @@
+/* Amalgamation of GrapheneOS hardened_malloc embedded in glibc.
+   Copyright (C) 2026 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.
+
+   Compiled as one translation unit so archive member names do not
+   collide with glibc's own random.os / util.os / pages.os / memory.os.  */
+
+#define MALLOC_EMBEDDED_IN_LIBC 1
+#define H_MALLOC_PREFIX 1
+
+#include "hardened_malloc/chacha.c"
+#include "hardened_malloc/memory.c"
+#include "hardened_malloc/pages.c"
+#include "hardened_malloc/random.c"
+#include "hardened_malloc/util.c"
+#include "hardened_malloc/h_malloc.c"
diff --git a/malloc/malloc-hardened-malloc.c b/malloc/malloc-hardened-malloc.c
new file mode 100644
index 0000000..c699e33
--- /dev/null
+++ b/malloc/malloc-hardened-malloc.c
@@ -0,0 +1,421 @@
+/* Shim to use hardened_malloc as the malloc implementation inside glibc.
+   Copyright (C) 2026 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.
+
+   The GNU C Library is free software; you can redistribute it and/or
+   modify it under the terms of the GNU Lesser General Public License as
+   published by the Free Software Foundation; either version 2.1 of the
+   License, or (at your option) any later version.
+
+   The GNU C Library is distributed in the hope that it will be useful,
+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+   Lesser General Public License for more details.
+
+   You should have received a copy of the GNU Lesser General Public
+   License along with the GNU C Library; see the file COPYING.LIB.  If
+   not, see <https://www.gnu.org/licenses/>.  */
+
+/* GrapheneOS hardened_malloc with -DH_MALLOC_PREFIX under malloc/hardened_malloc/. */
+
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+#include <malloc.h>
+#include <libc-symbols.h>
+#include <shlib-compat.h>
+#include <malloc-internal.h>
+#include "malloc-shim-compat.h"
+
+void *h_malloc (size_t);
+void h_free (void *);
+void *h_realloc (void *, size_t);
+void *h_calloc (size_t, size_t);
+void *h_memalign (size_t, size_t);
+void *h_aligned_alloc (size_t, size_t);
+void *h_valloc (size_t);
+void *h_pvalloc (size_t);
+int h_posix_memalign (void **, size_t, size_t);
+size_t h_malloc_usable_size (void *);
+int h_mallopt (int, int);
+int h_malloc_trim (size_t);
+void h_malloc_stats (void);
+int h_malloc_info (int, FILE *);
+struct mallinfo h_mallinfo (void);
+struct mallinfo2 h_mallinfo2 (void);
+void h_free_sized (void *, size_t);
+void h_free_aligned_sized (void *, size_t, size_t);
+
+#ifdef MALLOC_MULTI_BACKEND
+# define __libc_malloc __malloc_hardened_malloc_malloc
+# define __libc_free __malloc_hardened_malloc_free
+# define __libc_realloc __malloc_hardened_malloc_realloc
+# define __libc_calloc __malloc_hardened_malloc_calloc
+# define __libc_memalign __malloc_hardened_malloc_memalign
+# define __libc_valloc __malloc_hardened_malloc_valloc
+# define __libc_pvalloc __malloc_hardened_malloc_pvalloc
+# define __posix_memalign __malloc_hardened_malloc_posix_memalign
+# define aligned_alloc __malloc_hardened_malloc_aligned_alloc
+# define free_sized __malloc_hardened_malloc_free_sized
+# define free_aligned_sized __malloc_hardened_malloc_free_aligned_sized
+# define __malloc_usable_size __malloc_hardened_malloc_usable_size
+# define __libc_mallopt __malloc_hardened_malloc_mallopt
+# define __libc_mallinfo __malloc_hardened_malloc_mallinfo
+# define __libc_mallinfo2 __malloc_hardened_malloc_mallinfo2
+# define __malloc_info __malloc_hardened_malloc_malloc_info
+# define __malloc_stats __malloc_hardened_malloc_malloc_stats
+# define __malloc_trim __malloc_hardened_malloc_malloc_trim
+# define __malloc_fork_lock_parent __malloc_hardened_malloc_fork_lock_parent
+# define __malloc_fork_unlock_parent __malloc_hardened_malloc_fork_unlock_parent
+# define __malloc_fork_unlock_child __malloc_hardened_malloc_fork_unlock_child
+# define __malloc_arena_thread_freeres __malloc_hardened_malloc_arena_thread_freeres
+# define __malloc_check_init __malloc_hardened_malloc_check_init
+# define __ptmalloc_init __malloc_hardened_malloc_ptmalloc_init
+# define __glibc_morecore __malloc_hardened_malloc_morecore
+# pragma push_macro("libc_hidden_proto")
+# pragma push_macro("libc_hidden_def")
+# pragma push_macro("weak_function")
+# undef libc_hidden_proto
+# define libc_hidden_proto(...) /* nothing */
+# undef libc_hidden_def
+# define libc_hidden_def(...) /* nothing */
+# undef weak_function
+# define weak_function /* nothing */
+# define MALLOC_MULTI_HIDDEN_PUSHED 1
+#endif
+
+void *__libc_malloc (size_t);
+libc_hidden_proto (__libc_malloc)
+void __libc_free (void *);
+libc_hidden_proto (__libc_free)
+void *__libc_realloc (void *, size_t);
+libc_hidden_proto (__libc_realloc)
+void *__libc_memalign (size_t, size_t);
+libc_hidden_proto (__libc_memalign)
+struct mallinfo2 __libc_mallinfo2 (void);
+libc_hidden_proto (__libc_mallinfo2)
+int __libc_mallopt (int, int);
+libc_hidden_proto (__libc_mallopt)
+void *__libc_calloc (size_t, size_t);
+libc_hidden_proto (__libc_calloc)
+void *__libc_valloc (size_t);
+libc_hidden_proto (__libc_valloc)
+void *__libc_pvalloc (size_t);
+libc_hidden_proto (__libc_pvalloc)
+int __posix_memalign (void **, size_t, size_t);
+libc_hidden_proto (__posix_memalign)
+size_t __malloc_usable_size (void *);
+libc_hidden_proto (__malloc_usable_size)
+
+void *
+__libc_malloc (size_t bytes)
+{
+  if (malloc_shim_size_too_large (bytes))
+    return malloc_shim_fail_oom ();
+  return MALLOC_SHIM_CALL (h_malloc (bytes));
+}
+libc_hidden_def (__libc_malloc)
+
+void
+__libc_free (void *mem)
+{
+  if (mem == NULL)
+    return;
+  MALLOC_SHIM_FREE (h_free (mem));
+}
+libc_hidden_def (__libc_free)
+
+void *
+__libc_realloc (void *oldmem, size_t bytes)
+{
+  void *p;
+  if (bytes == 0)
+    {
+      if (oldmem != NULL)
+	{
+	  MALLOC_SHIM_FREE (h_free (oldmem));
+	  return NULL;
+	}
+      return MALLOC_SHIM_CALL (h_malloc (0));
+    }
+  if (malloc_shim_size_too_large (bytes))
+    return malloc_shim_fail_oom ();
+  if (oldmem == NULL)
+    return MALLOC_SHIM_CALL (h_malloc (bytes));
+  if (bytes <= h_malloc_usable_size (oldmem))
+    return oldmem;
+  p = h_realloc (oldmem, bytes);
+  if (p == NULL)
+    __set_errno (ENOMEM);
+  return p;
+}
+libc_hidden_def (__libc_realloc)
+
+void *
+__libc_calloc (size_t n, size_t elem_size)
+{
+  size_t bytes;
+  if (__builtin_mul_overflow (n, elem_size, &bytes) || malloc_shim_size_too_large (bytes))
+    return malloc_shim_fail_oom ();
+  return MALLOC_SHIM_CALL (h_calloc (n, elem_size));
+}
+libc_hidden_def (__libc_calloc)
+
+void *
+__libc_memalign (size_t alignment, size_t bytes)
+{
+  alignment = malloc_shim_align_pow2 (alignment);
+  if (alignment == 0 || malloc_shim_size_too_large (bytes)
+      || malloc_shim_size_too_large (alignment))
+    {
+      __set_errno (alignment == 0 ? EINVAL : ENOMEM);
+      return NULL;
+    }
+  return MALLOC_SHIM_CALL (h_memalign (alignment, bytes));
+}
+libc_hidden_def (__libc_memalign)
+
+void *
+__libc_valloc (size_t bytes)
+{
+  if (malloc_shim_size_too_large (bytes))
+    return malloc_shim_fail_oom ();
+  return MALLOC_SHIM_CALL (h_valloc (bytes));
+}
+libc_hidden_def (__libc_valloc)
+
+void *
+__libc_pvalloc (size_t bytes)
+{
+  size_t rounded = malloc_shim_pvalloc_size (bytes);
+  if (rounded == 0)
+    return malloc_shim_fail_oom ();
+  /* Avoid h_pvalloc: it treats a page-aligned zero as overflow and
+     returns NULL, breaking glibc's pvalloc (0) non-NULL guarantee.  */
+  return MALLOC_SHIM_CALL (h_memalign (__getpagesize (), rounded));
+}
+libc_hidden_def (__libc_pvalloc)
+
+int
+__posix_memalign (void **memptr, size_t alignment, size_t size)
+{
+  void *p;
+  if (memptr == NULL
+      || alignment == 0
+      || (alignment & (alignment - 1)) != 0
+      || alignment % sizeof (void *) != 0)
+    return EINVAL;
+  if (malloc_shim_size_too_large (size))
+    return ENOMEM;
+  p = h_memalign (alignment, size);
+  if (p == NULL)
+    return ENOMEM;
+  *memptr = p;
+  return 0;
+}
+libc_hidden_def (__posix_memalign)
+
+void *
+weak_function
+aligned_alloc (size_t alignment, size_t bytes)
+{
+  if (alignment == 0 || (alignment & (alignment - 1)) != 0)
+    {
+      __set_errno (EINVAL);
+      return NULL;
+    }
+  if (malloc_shim_size_too_large (bytes) || malloc_shim_size_too_large (alignment))
+    return malloc_shim_fail_oom ();
+  return MALLOC_SHIM_CALL (h_aligned_alloc (alignment, bytes));
+}
+
+void
+weak_function
+free_sized (void *ptr, size_t size)
+{
+  if (ptr == NULL)
+    return;
+  MALLOC_SHIM_FREE (h_free_sized (ptr, size));
+}
+
+void
+weak_function
+free_aligned_sized (void *ptr, size_t alignment, size_t size)
+{
+  if (ptr == NULL)
+    return;
+  MALLOC_SHIM_FREE (h_free_aligned_sized (ptr, alignment, size));
+}
+
+size_t
+__malloc_usable_size (void *mem)
+{
+  if (mem == NULL)
+    return 0;
+  return h_malloc_usable_size (mem);
+}
+libc_hidden_def (__malloc_usable_size)
+
+int
+__libc_mallopt (int param_number, int value)
+{
+  /* h_mallopt only implements Android M_PURGE and otherwise returns 0.
+     glibc callers treat non-zero as success for ignored tunables.  */
+  if (h_mallopt (param_number, value) != 0)
+    return 1;
+  return malloc_shim_mallopt_ignore (param_number, value);
+}
+#if IS_IN (libc) && !defined (MALLOC_MULTI_BACKEND)
+libc_hidden_def (__libc_mallopt)
+#endif
+
+struct mallinfo
+__libc_mallinfo (void)
+{
+  return h_mallinfo ();
+}
+
+struct mallinfo2
+__libc_mallinfo2 (void)
+{
+  return h_mallinfo2 ();
+}
+libc_hidden_def (__libc_mallinfo2)
+
+int
+__malloc_info (int options, FILE *fp)
+{
+  if (options != 0)
+    {
+      __set_errno (EINVAL);
+      return -1;
+    }
+  /* Minimal stable output: h_malloc_info walks metadata and calls
+     stdio while slabs may be sealed, which can recurse into malloc.  */
+  if (fprintf (fp, "<malloc version=\"hardened_malloc\">\n</malloc>\n") < 0)
+    return -1;
+  return 0;
+}
+
+void
+__malloc_stats (void)
+{
+  h_malloc_stats ();
+}
+
+int
+__malloc_trim (size_t pad __attribute__ ((unused)))
+{
+  return h_malloc_trim (pad);
+}
+
+void
+__malloc_fork_lock_parent (void)
+{
+}
+
+void
+__malloc_fork_unlock_parent (void)
+{
+}
+
+void
+__malloc_fork_unlock_child (void)
+{
+}
+
+void
+__malloc_arena_thread_freeres (void)
+{
+}
+
+void
+__malloc_check_init (void)
+{
+}
+
+void
+__ptmalloc_init (void)
+{
+  /* hardened_malloc initializes lazily on first use.  */
+}
+
+#ifndef MALLOC_MULTI_BACKEND
+void *__malloc_initialize_hook = NULL;
+void *__free_hook = NULL;
+void *__malloc_hook = NULL;
+void *__realloc_hook = NULL;
+void *__memalign_hook = NULL;
+void *__after_morecore_hook = NULL;
+void *__morecore = NULL;
+#endif
+
+void *
+__glibc_morecore (ptrdiff_t increment __attribute__ ((unused)))
+{
+  return NULL;
+}
+#if SHLIB_COMPAT (libc, GLIBC_2_0, GLIBC_2_34) && !defined (MALLOC_MULTI_BACKEND)
+compat_symbol (libc, __glibc_morecore, __default_morecore, GLIBC_2_0);
+#endif
+
+#if IS_IN (libc) && !defined (MALLOC_MULTI_BACKEND)
+strong_alias (__libc_malloc, malloc)
+strong_alias (__libc_realloc, realloc)
+strong_alias (__libc_free, free)
+weak_alias (__libc_calloc, calloc)
+weak_alias (__libc_memalign, memalign)
+weak_alias (__posix_memalign, posix_memalign)
+weak_alias (__libc_valloc, valloc)
+weak_alias (__libc_pvalloc, pvalloc)
+weak_alias (__malloc_usable_size, malloc_usable_size)
+weak_alias (__malloc_info, malloc_info)
+weak_alias (__libc_mallinfo, mallinfo)
+weak_alias (__libc_mallinfo2, mallinfo2)
+weak_alias (__libc_mallopt, mallopt)
+weak_alias (__malloc_stats, malloc_stats)
+weak_alias (__malloc_trim, malloc_trim)
+#endif
+
+#if SHLIB_COMPAT (libc, GLIBC_2_0, GLIBC_2_26) && !defined (MALLOC_MULTI_BACKEND)
+compat_symbol (libc, __libc_free, cfree, GLIBC_2_0);
+#endif
+
+#ifdef MALLOC_MULTI_BACKEND
+# ifdef MALLOC_MULTI_HIDDEN_PUSHED
+#  pragma pop_macro("weak_function")
+#  pragma pop_macro("libc_hidden_def")
+#  pragma pop_macro("libc_hidden_proto")
+# endif
+#include <malloc-backend.h>
+
+const struct libc_malloc_backend __libc_malloc_backend_hardened_malloc =
+{
+  .name = "hardened-malloc",
+  .init = __malloc_hardened_malloc_ptmalloc_init,
+  .malloc = __malloc_hardened_malloc_malloc,
+  .free = __malloc_hardened_malloc_free,
+  .realloc = __malloc_hardened_malloc_realloc,
+  .calloc = __malloc_hardened_malloc_calloc,
+  .memalign = __malloc_hardened_malloc_memalign,
+  .valloc = __malloc_hardened_malloc_valloc,
+  .pvalloc = __malloc_hardened_malloc_pvalloc,
+  .posix_memalign = __malloc_hardened_malloc_posix_memalign,
+  .aligned_alloc = __malloc_hardened_malloc_aligned_alloc,
+  .free_sized = __malloc_hardened_malloc_free_sized,
+  .free_aligned_sized = __malloc_hardened_malloc_free_aligned_sized,
+  .usable_size = __malloc_hardened_malloc_usable_size,
+  .mallopt = __malloc_hardened_malloc_mallopt,
+  .mallinfo = __malloc_hardened_malloc_mallinfo,
+  .mallinfo2 = __malloc_hardened_malloc_mallinfo2,
+  .malloc_info = __malloc_hardened_malloc_malloc_info,
+  .malloc_stats = __malloc_hardened_malloc_malloc_stats,
+  .malloc_trim = __malloc_hardened_malloc_malloc_trim,
+  .fork_lock_parent = __malloc_hardened_malloc_fork_lock_parent,
+  .fork_unlock_parent = __malloc_hardened_malloc_fork_unlock_parent,
+  .fork_unlock_child = __malloc_hardened_malloc_fork_unlock_child,
+  .arena_thread_freeres = __malloc_hardened_malloc_arena_thread_freeres,
+  .check_init = __malloc_hardened_malloc_check_init,
+};
+#endif
