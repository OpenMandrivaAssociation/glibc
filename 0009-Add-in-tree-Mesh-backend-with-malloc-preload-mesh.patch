From: =?UTF-8?q?Bernhard=20Rosenkr=C3=A4nzer?= <bero@lindev.ch>
Date: Wed, 19 Aug 2026 19:00:00 +0200
Subject: [PATCH 09/13] Add Mesh backend glue (--with-malloc-preload=mesh)

Shim and preload TUs only.  Upstream Mesh + Heap-Layers come from the
mesh tarball unpacked into malloc/mesh/ in %prep.
---
 malloc/malloc-mesh-impl.cc    |  38 +++
 malloc/malloc-mesh-preload.cc |  57 +++++
 malloc/malloc-mesh.c          | 428 ++++++++++++++++++++++++++++++++++
 3 files changed, 523 insertions(+)
 create mode 100644 malloc/malloc-mesh-impl.cc
 create mode 100644 malloc/malloc-mesh-preload.cc
 create mode 100644 malloc/malloc-mesh.c

diff --git a/malloc/malloc-mesh-impl.cc b/malloc/malloc-mesh-impl.cc
new file mode 100644
index 0000000..014eeba
--- /dev/null
+++ b/malloc/malloc-mesh-impl.cc
@@ -0,0 +1,38 @@
+/* C++ amalgamation of plasma-umass Mesh embedded in glibc.
+   Copyright (C) 2026 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.  */
+
+#define MESH_EMBEDDED_IN_LIBC 1
+#ifndef MESH_EXPORT
+# define MESH_EXPORT __attribute__ ((visibility ("hidden")))
+#endif
+
+#include "mesh/src/d_assert.cc"
+#include "mesh/src/real.cc"
+#include "mesh/src/runtime.cc"
+#include "mesh/src/global_heap.cc"
+#include "mesh/src/meshable_arena.cc"
+#include "mesh/src/thread_local_heap.cc"
+#include "mesh/src/memory_stats_linux.cc"
+#include "mesh/src/libmesh.cc"
+
+#include "runtime.h"
+
+extern "C" void mesh_fork_prepare (void) {
+  if (mesh::getPageSize() == mesh::kPageSize4K)
+    mesh::runtime<mesh::kPageSize4K>().heap().lock();
+  else
+    mesh::runtime<mesh::kPageSize16K>().heap().lock();
+}
+extern "C" void mesh_fork_parent (void) {
+  if (mesh::getPageSize() == mesh::kPageSize4K)
+    mesh::runtime<mesh::kPageSize4K>().heap().unlock();
+  else
+    mesh::runtime<mesh::kPageSize16K>().heap().unlock();
+}
+extern "C" void mesh_fork_child (void) {
+  if (mesh::getPageSize() == mesh::kPageSize4K)
+    mesh::runtime<mesh::kPageSize4K>().heap().unlock();
+  else
+    mesh::runtime<mesh::kPageSize16K>().heap().unlock();
+}
diff --git a/malloc/malloc-mesh-preload.cc b/malloc/malloc-mesh-preload.cc
new file mode 100644
index 0000000..cf43dae
--- /dev/null
+++ b/malloc/malloc-mesh-preload.cc
@@ -0,0 +1,57 @@
+/* LD_PRELOAD entry for Mesh.  Copyright (C) 2026 Free Software Foundation.
+   Separate DSO linked with libstdc++; depends on libc, never linked into it. */
+
+#define MESH_EMBEDDED_IN_LIBC 1
+#define MESHING_ENABLED 1
+#define SHUFFLE_ON_INIT 1
+#define SHUFFLE_ON_FREE 0
+#ifndef MESH_EXPORT
+# define MESH_EXPORT __attribute__((visibility("default")))
+#endif
+
+#include "mesh/src/d_assert.cc"
+#include "mesh/src/real.cc"
+#include "mesh/src/runtime.cc"
+#include "mesh/src/global_heap.cc"
+#include "mesh/src/meshable_arena.cc"
+#include "mesh/src/thread_local_heap.cc"
+#include "mesh/src/memory_stats_linux.cc"
+#include "mesh/src/libmesh.cc"
+
+#include <errno.h>
+#include <stddef.h>
+#include <unistd.h>
+
+extern "C" {
+void *mesh_malloc(size_t);
+void mesh_free(void *);
+void *mesh_realloc(void *, size_t);
+void *mesh_calloc(size_t, size_t);
+void *mesh_memalign(size_t, size_t);
+size_t mesh_malloc_usable_size(void *);
+}
+
+extern "C" {
+void *malloc(size_t n) { return mesh_malloc(n); }
+void free(void *p) { mesh_free(p); }
+void *calloc(size_t n, size_t s) { return mesh_calloc(n, s); }
+void *realloc(void *p, size_t n) { return mesh_realloc(p, n); }
+void *memalign(size_t a, size_t n) { return mesh_memalign(a, n); }
+void *aligned_alloc(size_t a, size_t n) {
+  if (!a || (a & (a - 1))) { errno = EINVAL; return nullptr; }
+  return mesh_memalign(a, n);
+}
+int posix_memalign(void **m, size_t a, size_t n) {
+  if (!m || !a || (a & (a - 1)) || a % sizeof(void *)) return EINVAL;
+  void *p = mesh_memalign(a, n);
+  if (!p) return ENOMEM;
+  *m = p; return 0;
+}
+void *valloc(size_t n) { return mesh_memalign((size_t)sysconf(_SC_PAGESIZE), n); }
+size_t malloc_usable_size(void *p) { return mesh_malloc_usable_size(p); }
+void *__libc_malloc(size_t n) { return malloc(n); }
+void __libc_free(void *p) { free(p); }
+void *__libc_realloc(void *p, size_t n) { return realloc(p, n); }
+void *__libc_calloc(size_t n, size_t s) { return calloc(n, s); }
+void *__libc_memalign(size_t a, size_t n) { return memalign(a, n); }
+}
diff --git a/malloc/malloc-mesh.c b/malloc/malloc-mesh.c
new file mode 100644
index 0000000..cbc8afe
--- /dev/null
+++ b/malloc/malloc-mesh.c
@@ -0,0 +1,428 @@
+/* Shim to use Mesh as the malloc implementation inside glibc.
+   Copyright (C) 2026 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.
+
+   The GNU C Library is free software; you can redistribute it and/or
+   modify it under the terms of the GNU Lesser General Public License as
+   published by the Free Software Foundation; either version 2.1 of the
+   License, or (at your option) any later version.
+
+   The GNU C Library is distributed in the hope that it will be useful,
+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+   Lesser General Public License for more details.
+
+   You should have received a copy of the GNU Lesser General Public
+   License along with the GNU C Library; see the file COPYING.LIB.  If
+   not, see <https://www.gnu.org/licenses/>.  */
+
+/* plasma-umass Mesh embedded under malloc/mesh/. */
+
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+#include <malloc.h>
+#include <libc-symbols.h>
+#include <shlib-compat.h>
+#include <malloc-internal.h>
+#include "malloc-shim-compat.h"
+
+#if IS_IN (libc) && defined SHARED
+extern int __cxa_atexit (void (*func) (void *), void *arg, void *dso_handle);
+extern void *__dso_handle __attribute__ ((weak));
+extern int __register_atfork (void (*) (void), void (*) (void),
+			      void (*) (void), void *);
+
+__attribute__ ((weak)) int
+atexit (void (*func) (void))
+{
+  return __cxa_atexit ((void (*) (void *)) func, 0,
+		       &__dso_handle == 0 ? 0 : __dso_handle);
+}
+
+__attribute__ ((weak)) int
+pthread_atfork (void (*prepare) (void), void (*parent) (void),
+		void (*child) (void))
+{
+  return __register_atfork (prepare, parent, child, &__dso_handle);
+}
+#endif
+
+
+void *mesh_malloc (size_t);
+void mesh_free (void *);
+void *mesh_realloc (void *, size_t);
+void *mesh_calloc (size_t, size_t);
+void *mesh_memalign (size_t, size_t);
+size_t mesh_malloc_usable_size (void *);
+void mesh_sized_free (void *, size_t);
+
+#ifdef MALLOC_MULTI_BACKEND
+# define __libc_malloc __malloc_mesh_malloc
+# define __libc_free __malloc_mesh_free
+# define __libc_realloc __malloc_mesh_realloc
+# define __libc_calloc __malloc_mesh_calloc
+# define __libc_memalign __malloc_mesh_memalign
+# define __libc_valloc __malloc_mesh_valloc
+# define __libc_pvalloc __malloc_mesh_pvalloc
+# define __posix_memalign __malloc_mesh_posix_memalign
+# define aligned_alloc __malloc_mesh_aligned_alloc
+# define free_sized __malloc_mesh_free_sized
+# define free_aligned_sized __malloc_mesh_free_aligned_sized
+# define __malloc_usable_size __malloc_mesh_usable_size
+# define __libc_mallopt __malloc_mesh_mallopt
+# define __libc_mallinfo __malloc_mesh_mallinfo
+# define __libc_mallinfo2 __malloc_mesh_mallinfo2
+# define __malloc_info __malloc_mesh_malloc_info
+# define __malloc_stats __malloc_mesh_malloc_stats
+# define __malloc_trim __malloc_mesh_malloc_trim
+# define __malloc_fork_lock_parent __malloc_mesh_fork_lock_parent
+# define __malloc_fork_unlock_parent __malloc_mesh_fork_unlock_parent
+# define __malloc_fork_unlock_child __malloc_mesh_fork_unlock_child
+# define __malloc_arena_thread_freeres __malloc_mesh_arena_thread_freeres
+# define __malloc_check_init __malloc_mesh_check_init
+# define __ptmalloc_init __malloc_mesh_ptmalloc_init
+# define __glibc_morecore __malloc_mesh_morecore
+# pragma push_macro("libc_hidden_proto")
+# pragma push_macro("libc_hidden_def")
+# pragma push_macro("weak_function")
+# undef libc_hidden_proto
+# define libc_hidden_proto(...) /* nothing */
+# undef libc_hidden_def
+# define libc_hidden_def(...) /* nothing */
+# undef weak_function
+# define weak_function /* nothing */
+# define MALLOC_MULTI_HIDDEN_PUSHED 1
+#endif
+
+void *__libc_malloc (size_t);
+libc_hidden_proto (__libc_malloc)
+void __libc_free (void *);
+libc_hidden_proto (__libc_free)
+void *__libc_realloc (void *, size_t);
+libc_hidden_proto (__libc_realloc)
+void *__libc_memalign (size_t, size_t);
+libc_hidden_proto (__libc_memalign)
+struct mallinfo2 __libc_mallinfo2 (void);
+libc_hidden_proto (__libc_mallinfo2)
+int __libc_mallopt (int, int);
+libc_hidden_proto (__libc_mallopt)
+void *__libc_calloc (size_t, size_t);
+libc_hidden_proto (__libc_calloc)
+void *__libc_valloc (size_t);
+libc_hidden_proto (__libc_valloc)
+void *__libc_pvalloc (size_t);
+libc_hidden_proto (__libc_pvalloc)
+int __posix_memalign (void **, size_t, size_t);
+libc_hidden_proto (__posix_memalign)
+size_t __malloc_usable_size (void *);
+libc_hidden_proto (__malloc_usable_size)
+
+void *
+__libc_malloc (size_t bytes)
+{
+  if (malloc_shim_size_too_large (bytes))
+    return malloc_shim_fail_oom ();
+  return MALLOC_SHIM_CALL (mesh_malloc (bytes));
+}
+libc_hidden_def (__libc_malloc)
+
+void
+__libc_free (void *mem)
+{
+  if (mem == NULL)
+    return;
+  MALLOC_SHIM_FREE (mesh_free (mem));
+}
+libc_hidden_def (__libc_free)
+
+void *
+__libc_realloc (void *oldmem, size_t bytes)
+{
+  void *p;
+  if (bytes == 0)
+    {
+      if (oldmem != NULL)
+	{
+	  MALLOC_SHIM_FREE (mesh_free (oldmem));
+	  return NULL;
+	}
+      return MALLOC_SHIM_CALL (mesh_malloc (0));
+    }
+  if (malloc_shim_size_too_large (bytes))
+    return malloc_shim_fail_oom ();
+  if (oldmem == NULL)
+    return MALLOC_SHIM_CALL (mesh_malloc (bytes));
+  if (bytes <= mesh_malloc_usable_size (oldmem))
+    return oldmem;
+  p = mesh_realloc (oldmem, bytes);
+  if (p == NULL)
+    __set_errno (ENOMEM);
+  return p;
+}
+libc_hidden_def (__libc_realloc)
+
+void *
+__libc_calloc (size_t n, size_t elem_size)
+{
+  size_t bytes;
+  if (__builtin_mul_overflow (n, elem_size, &bytes) || malloc_shim_size_too_large (bytes))
+    return malloc_shim_fail_oom ();
+  return MALLOC_SHIM_CALL (mesh_calloc (n, elem_size));
+}
+libc_hidden_def (__libc_calloc)
+
+void *
+__libc_memalign (size_t alignment, size_t bytes)
+{
+  alignment = malloc_shim_align_pow2 (alignment);
+  if (alignment == 0 || malloc_shim_size_too_large (bytes)
+      || malloc_shim_size_too_large (alignment))
+    {
+      __set_errno (alignment == 0 ? EINVAL : ENOMEM);
+      return NULL;
+    }
+  return MALLOC_SHIM_CALL (mesh_memalign (alignment, bytes));
+}
+libc_hidden_def (__libc_memalign)
+
+void *
+__libc_valloc (size_t bytes)
+{
+  if (malloc_shim_size_too_large (bytes))
+    return malloc_shim_fail_oom ();
+  return MALLOC_SHIM_CALL (mesh_memalign (__getpagesize (), bytes));
+}
+libc_hidden_def (__libc_valloc)
+
+void *
+__libc_pvalloc (size_t bytes)
+{
+  size_t rounded = malloc_shim_pvalloc_size (bytes);
+  if (rounded == 0)
+    return malloc_shim_fail_oom ();
+  return MALLOC_SHIM_CALL (mesh_memalign (__getpagesize (), rounded));
+}
+libc_hidden_def (__libc_pvalloc)
+
+int
+__posix_memalign (void **memptr, size_t alignment, size_t size)
+{
+  void *p;
+  if (memptr == NULL
+      || alignment == 0
+      || (alignment & (alignment - 1)) != 0
+      || alignment % sizeof (void *) != 0)
+    return EINVAL;
+  if (malloc_shim_size_too_large (size))
+    return ENOMEM;
+  p = mesh_memalign (alignment, size);
+  if (p == NULL)
+    return ENOMEM;
+  *memptr = p;
+  return 0;
+}
+libc_hidden_def (__posix_memalign)
+
+void *
+weak_function
+aligned_alloc (size_t alignment, size_t bytes)
+{
+  if (alignment == 0 || (alignment & (alignment - 1)) != 0)
+    {
+      __set_errno (EINVAL);
+      return NULL;
+    }
+  if (malloc_shim_size_too_large (bytes) || malloc_shim_size_too_large (alignment))
+    return malloc_shim_fail_oom ();
+  return MALLOC_SHIM_CALL (mesh_memalign (alignment, bytes));
+}
+
+void
+weak_function
+free_sized (void *ptr, size_t size)
+{
+  if (ptr == NULL)
+    return;
+  MALLOC_SHIM_FREE (mesh_sized_free (ptr, size));
+}
+
+void
+weak_function
+free_aligned_sized (void *ptr, size_t alignment, size_t size)
+{
+  if (ptr == NULL)
+    return;
+  MALLOC_SHIM_FREE (mesh_free (ptr));
+}
+
+size_t
+__malloc_usable_size (void *mem)
+{
+  if (mem == NULL)
+    return 0;
+  return mesh_malloc_usable_size (mem);
+}
+libc_hidden_def (__malloc_usable_size)
+
+int
+__libc_mallopt (int param_number, int value)
+{
+  return malloc_shim_mallopt_ignore (param_number, value);
+}
+#if IS_IN (libc) && !defined (MALLOC_MULTI_BACKEND)
+libc_hidden_def (__libc_mallopt)
+#endif
+
+struct mallinfo
+__libc_mallinfo (void)
+{
+  struct mallinfo info;
+  memset (&info, 0, sizeof (info));
+  return info;
+}
+
+struct mallinfo2
+__libc_mallinfo2 (void)
+{
+  struct mallinfo2 info;
+  memset (&info, 0, sizeof (info));
+  return info;
+}
+libc_hidden_def (__libc_mallinfo2)
+
+int
+__malloc_info (int options, FILE *fp)
+{
+  (void) options; fprintf (fp, "<malloc version=\"mesh\">\n</malloc>\n"); return 0;
+}
+
+void
+__malloc_stats (void)
+{
+  /* no-op */
+}
+
+int
+__malloc_trim (size_t pad __attribute__ ((unused)))
+{
+  (void) pad; return 0;
+}
+
+extern void mesh_fork_prepare (void);
+extern void mesh_fork_parent (void);
+extern void mesh_fork_child (void);
+
+void
+__malloc_fork_lock_parent (void)
+{
+  mesh_fork_prepare ();
+}
+
+void
+__malloc_fork_unlock_parent (void)
+{
+  mesh_fork_parent ();
+}
+
+void
+__malloc_fork_unlock_child (void)
+{
+  mesh_fork_child ();
+}
+
+void
+__malloc_arena_thread_freeres (void)
+{
+}
+
+void
+__malloc_check_init (void)
+{
+}
+
+void
+__ptmalloc_init (void)
+{
+  /* Mesh self-initializes via its constructor.  */
+}
+
+#ifndef MALLOC_MULTI_BACKEND
+void *__malloc_initialize_hook = NULL;
+void *__free_hook = NULL;
+void *__malloc_hook = NULL;
+void *__realloc_hook = NULL;
+void *__memalign_hook = NULL;
+void *__after_morecore_hook = NULL;
+void *__morecore = NULL;
+#endif
+
+void *
+__glibc_morecore (ptrdiff_t increment __attribute__ ((unused)))
+{
+  return NULL;
+}
+#if SHLIB_COMPAT (libc, GLIBC_2_0, GLIBC_2_34) && !defined (MALLOC_MULTI_BACKEND)
+compat_symbol (libc, __glibc_morecore, __default_morecore, GLIBC_2_0);
+#endif
+
+#if IS_IN (libc) && !defined (MALLOC_MULTI_BACKEND)
+strong_alias (__libc_malloc, malloc)
+strong_alias (__libc_realloc, realloc)
+strong_alias (__libc_free, free)
+weak_alias (__libc_calloc, calloc)
+weak_alias (__libc_memalign, memalign)
+weak_alias (__posix_memalign, posix_memalign)
+weak_alias (__libc_valloc, valloc)
+weak_alias (__libc_pvalloc, pvalloc)
+weak_alias (__malloc_usable_size, malloc_usable_size)
+weak_alias (__malloc_info, malloc_info)
+weak_alias (__libc_mallinfo, mallinfo)
+weak_alias (__libc_mallinfo2, mallinfo2)
+weak_alias (__libc_mallopt, mallopt)
+weak_alias (__malloc_stats, malloc_stats)
+weak_alias (__malloc_trim, malloc_trim)
+#endif
+
+#if SHLIB_COMPAT (libc, GLIBC_2_0, GLIBC_2_26) && !defined (MALLOC_MULTI_BACKEND)
+compat_symbol (libc, __libc_free, cfree, GLIBC_2_0);
+#endif
+
+#ifdef MALLOC_MULTI_BACKEND
+# ifdef MALLOC_MULTI_HIDDEN_PUSHED
+#  pragma pop_macro("weak_function")
+#  pragma pop_macro("libc_hidden_def")
+#  pragma pop_macro("libc_hidden_proto")
+# endif
+#include <malloc-backend.h>
+
+const struct libc_malloc_backend __libc_malloc_backend_mesh =
+{
+  .name = "mesh",
+  .init = __malloc_mesh_ptmalloc_init,
+  .malloc = __malloc_mesh_malloc,
+  .free = __malloc_mesh_free,
+  .realloc = __malloc_mesh_realloc,
+  .calloc = __malloc_mesh_calloc,
+  .memalign = __malloc_mesh_memalign,
+  .valloc = __malloc_mesh_valloc,
+  .pvalloc = __malloc_mesh_pvalloc,
+  .posix_memalign = __malloc_mesh_posix_memalign,
+  .aligned_alloc = __malloc_mesh_aligned_alloc,
+  .free_sized = __malloc_mesh_free_sized,
+  .free_aligned_sized = __malloc_mesh_free_aligned_sized,
+  .usable_size = __malloc_mesh_usable_size,
+  .mallopt = __malloc_mesh_mallopt,
+  .mallinfo = __malloc_mesh_mallinfo,
+  .mallinfo2 = __malloc_mesh_mallinfo2,
+  .malloc_info = __malloc_mesh_malloc_info,
+  .malloc_stats = __malloc_mesh_malloc_stats,
+  .malloc_trim = __malloc_mesh_malloc_trim,
+  .fork_lock_parent = __malloc_mesh_fork_lock_parent,
+  .fork_unlock_parent = __malloc_mesh_fork_unlock_parent,
+  .fork_unlock_child = __malloc_mesh_fork_unlock_child,
+  .arena_thread_freeres = __malloc_mesh_arena_thread_freeres,
+  .check_init = __malloc_mesh_check_init,
+};
+#endif
