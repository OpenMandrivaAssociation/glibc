From d1fdf0b381d9d8f99a94954112beaff9f732a50c Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Bernhard=20Rosenkr=C3=A4nzer?= <bero@lindev.ch>
Date: Wed, 11 Nov 2026 18:43:37 +0100
Subject: [PATCH] stdio-common: Do not write a second NUL after wide %s/%[
 (CVE-2026-115819)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

__vfwscanf_internal finishes a %s or %[ conversion into a multibyte
buffer with __wcrtomb of L'\0'.  That conversion already stores the
terminating NUL and any shift back to the initial state.  Appending
another NUL writes one byte past a buffer sized for the converted
string and a single terminator.

Reject a failed __wcrtomb before copying it.  (size_t) -1 is greater
than zero, so the old n > 0 check would hand a failed conversion to
mempcpy.  The narrow scanf path still stores its own terminator.

Upstream published GLIBC-SA-2026-0027 with no Fix-Commit.

Reported-by: Russell Miller <rmiller@duskglow.com>
Signed-off-by: Bernhard Rosenkränzer <bero@lindev.ch>
---
 NEWS                             |  5 +++
 stdio-common/Makefile            |  1 +
 stdio-common/tst-wscanf-mb-nul.c | 73 ++++++++++++++++++++++++++++++++
 stdio-common/vfscanf-internal.c  | 22 +++++++++-
 4 files changed, 99 insertions(+), 2 deletions(-)
 create mode 100644 stdio-common/tst-wscanf-mb-nul.c

diff --git a/NEWS b/NEWS
index 5445e120..e5a223b4 100644
--- a/NEWS
+++ b/NEWS
@@ -7,6 +7,11 @@ using `glibc' in the "product" field.
 
 Version 2.44.1
 
+* Wide scanf conversions of %s and %[ to a multibyte string no longer
+  write a NUL past the end of the caller's buffer.  The conversion to
+  the initial shift state already stores the terminating NUL
+  (CVE-2026-115819, GLIBC-SA-2026-0027).
+
 The following bugs are resolved with this release:
 
   [33085] libc: nftw: readdir() errors are ignored
diff --git a/stdio-common/Makefile b/stdio-common/Makefile
index a948bfde..04319a6d 100644
--- a/stdio-common/Makefile
+++ b/stdio-common/Makefile
@@ -353,6 +353,7 @@ tests := \
   tst-vfscanf-bz34008 \
   tst-wc-printf \
   tst-wscanf-bz34208 \
+  tst-wscanf-mb-nul \
   tstdiomisc \
   tstgetln \
   tstscanf \
diff --git a/stdio-common/tst-wscanf-mb-nul.c b/stdio-common/tst-wscanf-mb-nul.c
new file mode 100644
index 00000000..92a7540a
--- /dev/null
+++ b/stdio-common/tst-wscanf-mb-nul.c
@@ -0,0 +1,73 @@
+/* Wide scanf %s/%[ must not write a second NUL (CVE-2026-115819).
+   Copyright (C) 2026 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.
+
+   The GNU C Library is free software; you can redistribute it and/or
+   modify it under the terms of the GNU Lesser General Public
+   License as published by the Free Software Foundation; either
+   version 2.1 of the License, or (at your option) any later version.
+
+   The GNU C Library is distributed in the hope that it will be useful,
+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+   Lesser General Public License for more details.
+
+   You should have received a copy of the GNU Lesser General Public
+   License along with the GNU C Library; if not, see
+   <https://www.gnu.org/licenses/>.  */
+
+#include <locale.h>
+#include <stdio.h>
+#include <string.h>
+#include <wchar.h>
+
+#include <support/check.h>
+
+/* Convert INPUT with FMT into a byte buffer and check that the byte
+   after the terminating NUL is untouched.  EXPECTED includes no NUL;
+   the converted result must be that string followed by one NUL.  */
+
+static void
+check_wide (const wchar_t *input, const wchar_t *fmt, const char *expected)
+{
+  char buf[16];
+  memset (buf, 0xa5, sizeof buf);
+  TEST_COMPARE (swscanf (input, fmt, buf), 1);
+  size_t len = strlen (expected);
+  TEST_COMPARE_BLOB (buf, len + 1, expected, len + 1);
+  TEST_COMPARE ((unsigned char) buf[len + 1], 0xa5);
+}
+
+static void
+check_narrow (const char *input, const char *fmt, const char *expected)
+{
+  char buf[16];
+  memset (buf, 0xa5, sizeof buf);
+  TEST_COMPARE (sscanf (input, fmt, buf), 1);
+  size_t len = strlen (expected);
+  TEST_COMPARE_BLOB (buf, len + 1, expected, len + 1);
+  TEST_COMPARE ((unsigned char) buf[len + 1], 0xa5);
+}
+
+static int
+do_test (void)
+{
+  if (setlocale (LC_ALL, "C.UTF-8") == NULL)
+    FAIL_EXIT1 ("C.UTF-8 locale not available");
+
+  check_wide (L"abc", L"%3s", "abc");
+  check_wide (L"abc", L"%s", "abc");
+  check_wide (L"abc", L"%3[a-z]", "abc");
+  check_wide (L"abc", L"%[a-z]", "abc");
+  check_wide (L"ab c", L"%s", "ab");
+  check_wide (L"\u00e9\u00e9", L"%2s", "\xc3\xa9\xc3\xa9");
+  check_wide (L"\u00e9\u00e9", L"%2[^\n]", "\xc3\xa9\xc3\xa9");
+
+  /* The narrow path still stores its own terminator.  */
+  check_narrow ("abc", "%3s", "abc");
+  check_narrow ("abc", "%3[a-z]", "abc");
+
+  return 0;
+}
+
+#include <support/test-driver.c>
diff --git a/stdio-common/vfscanf-internal.c b/stdio-common/vfscanf-internal.c
index 5f548f70..791944e9 100644
--- a/stdio-common/vfscanf-internal.c
+++ b/stdio-common/vfscanf-internal.c
@@ -1220,6 +1220,14 @@ __vfscanf_internal (FILE *s, const char *format, va_list argptr,
 		     state.  */
 		  char buf[MB_LEN_MAX];
 		  size_t n = __wcrtomb (buf, L'\0', &state);
+		  /* Converting L'\0' stores the terminating NUL and any
+		     shift back to the initial state.  Do not append another
+		     NUL: that writes past a buffer sized for the converted
+		     multibyte string plus one terminator.  (size_t) -1 is
+		     greater than zero, so reject a failed conversion before
+		     copying it.  */
+		  if (__glibc_unlikely (n == (size_t) -1))
+		    encode_error ();
 		  if (n > 0 && (flags & MALLOC)
 		      && str + n >= *strptr + strsize)
 		    {
@@ -1252,8 +1260,9 @@ __vfscanf_internal (FILE *s, const char *format, va_list argptr,
 		    }
 
 		  str = __mempcpy (str, buf, n);
-#endif
+#else
 		  *str++ = '\0';
+#endif
 
 		  if ((flags & MALLOC) && str - *strptr != strsize)
 		    {
@@ -3148,6 +3157,14 @@ digits_extended_fail:
 		     state.  */
 		  char buf[MB_LEN_MAX];
 		  size_t n = __wcrtomb (buf, L'\0', &state);
+		  /* Converting L'\0' stores the terminating NUL and any
+		     shift back to the initial state.  Do not append another
+		     NUL: that writes past a buffer sized for the converted
+		     multibyte string plus one terminator.  (size_t) -1 is
+		     greater than zero, so reject a failed conversion before
+		     copying it.  */
+		  if (__glibc_unlikely (n == (size_t) -1))
+		    encode_error ();
 		  if (n > 0 && (flags & MALLOC)
 		      && str + n >= *strptr + strsize)
 		    {
@@ -3180,8 +3197,9 @@ digits_extended_fail:
 		    }
 
 		  str = __mempcpy (str, buf, n);
-#endif
+#else
 		  *str++ = '\0';
+#endif
 
 		  if ((flags & MALLOC) && str - *strptr != strsize)
 		    {
-- 
